# Particle primitive POC: pure Pixil reference implementation.
# Keep state, operation order, and frame count identical to the primitive version.

throttle(0)
fps(0)

v_count = 16
v_frames = 120
v_radius = 1.5
v_diameter = v_radius * 2
v_left = 3
v_right = 60
v_top = 3
v_bottom = 60
v_damping = 0.992
v_wall_restitution = 0.88
v_pair_restitution = 0.97
v_sleep_speed = 0.01

create_array(v_x, v_count, numeric)
create_array(v_y, v_count, numeric)
create_array(v_vx, v_count, numeric)
create_array(v_vy, v_count, numeric)
create_array(v_active, v_count, numeric)

# Deterministic 4x4 field; no random values so both POCs are comparable.
for v_i in (0, v_count - 1, 1)
    v_x[v_i] = 9 + (v_i % 4) * 14
    v_y[v_i] = 9 + int(v_i / 4) * 14
    v_vx[v_i] = ((v_i % 3) - 1) * 0.8
    v_vy[v_i] = ((v_i % 5) - 2) * 0.35
    if v_vx[v_i] == 0 then
        v_vx[v_i] = 0.35
    endif
    v_active[v_i] = 1
endfor v_i

v_start_ms = get_system("runtime")

for v_frame in (0, v_frames - 1, 1)
    # particle_integrate equivalent
    for v_i in (0, v_count - 1, 1)
        if v_active[v_i] != 0 then
            v_x[v_i] = v_x[v_i] + v_vx[v_i]
            v_y[v_i] = v_y[v_i] + v_vy[v_i]
            v_vx[v_i] = v_vx[v_i] * v_damping
            v_vy[v_i] = v_vy[v_i] * v_damping
            if abs(v_vx[v_i]) < v_sleep_speed then
                v_vx[v_i] = 0
            endif
            if abs(v_vy[v_i]) < v_sleep_speed then
                v_vy[v_i] = 0
            endif
        endif
    endfor v_i

    # particle_collide_bounds equivalent
    for v_i in (0, v_count - 1, 1)
        if v_active[v_i] != 0 then
            v_min_x = v_left + v_radius
            v_max_x = v_right - v_radius
            v_min_y = v_top + v_radius
            v_max_y = v_bottom - v_radius
            if v_x[v_i] < v_min_x then
                v_x[v_i] = v_min_x
                v_vx[v_i] = abs(v_vx[v_i]) * v_wall_restitution
            elseif v_x[v_i] > v_max_x then
                v_x[v_i] = v_max_x
                v_vx[v_i] = -abs(v_vx[v_i]) * v_wall_restitution
            endif
            if v_y[v_i] < v_min_y then
                v_y[v_i] = v_min_y
                v_vy[v_i] = abs(v_vy[v_i]) * v_wall_restitution
            elseif v_y[v_i] > v_max_y then
                v_y[v_i] = v_max_y
                v_vy[v_i] = -abs(v_vy[v_i]) * v_wall_restitution
            endif
        endif
    endfor v_i

    # particle_collide_circles equivalent (equal mass).
    for v_i in (0, v_count - 2, 1)
        if v_active[v_i] != 0 then
            for v_j in (v_i + 1, v_count - 1, 1)
                if v_active[v_j] != 0 then
                    v_dx = v_x[v_j] - v_x[v_i]
                    if abs(v_dx) < v_diameter then
                        v_dy = v_y[v_j] - v_y[v_i]
                        if abs(v_dy) < v_diameter then
                            v_dist_sq = v_dx * v_dx + v_dy * v_dy
                            if v_dist_sq < v_diameter * v_diameter then
                                if v_dist_sq <= 0.000000000001 then
                                    v_dist = 0
                                    v_nx = 1
                                    v_ny = 0
                                else
                                    v_dist = sqrt(v_dist_sq)
                                    v_nx = v_dx / v_dist
                                    v_ny = v_dy / v_dist
                                endif

                                v_overlap = v_diameter - v_dist
                                v_x[v_i] = v_x[v_i] - v_nx * v_overlap * 0.5
                                v_y[v_i] = v_y[v_i] - v_ny * v_overlap * 0.5
                                v_x[v_j] = v_x[v_j] + v_nx * v_overlap * 0.5
                                v_y[v_j] = v_y[v_j] + v_ny * v_overlap * 0.5

                                v_relative = (v_vx[v_j] - v_vx[v_i]) * v_nx + (v_vy[v_j] - v_vy[v_i]) * v_ny
                                if v_relative < 0 then
                                    v_impulse = -(1 + v_pair_restitution) * v_relative / 2
                                    v_vx[v_i] = v_vx[v_i] - v_impulse * v_nx
                                    v_vy[v_i] = v_vy[v_i] - v_impulse * v_ny
                                    v_vx[v_j] = v_vx[v_j] + v_impulse * v_nx
                                    v_vy[v_j] = v_vy[v_j] + v_impulse * v_ny
                                endif
                            endif
                        endif
                    endif
                endif
            endfor v_j
        endif
    endfor v_i
endfor v_frame

v_elapsed_ms = get_system("runtime") - v_start_ms
v_checksum = 0
for v_i in (0, v_count - 1, 1)
    v_checksum = v_checksum + v_x[v_i] + v_y[v_i] + v_vx[v_i] + v_vy[v_i]
endfor v_i

print(f"PARTICLE_PERF variant=reference frames={v_frames} elapsed_ms={v_elapsed_ms} checksum={v_checksum}")
