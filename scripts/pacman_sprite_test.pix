# ================================================================
# Pac-Man sprite cel animation smoke test
# ================================================================
clear()
print("TEST: Pac-Man cel animation")
fps(20)
sync_queue

define_sprite(pacman, 12, 12)
    sprite_cel(0)
        # Closed mouth
        draw_circle(6, 6, 5, yellow, 100, true)
        plot(8, 4, black, 100)

    sprite_cel(1)
        # Slightly open
        draw_circle(6, 6, 5, yellow, 100, true)
        draw_polygon(11, 6, 4, 3, black, 100, 0, true)
        plot(8, 4, black, 100)

    sprite_cel(2)
        # Wide open
        draw_circle(6, 6, 5, yellow, 100, true)
        draw_polygon(11, 6, 5, 3, black, 100, 0, true)
        plot(8, 4, black, 100)

    sprite_cel(3)
        # Slightly open (closing)
        draw_circle(6, 6, 5, yellow, 100, true)
        draw_polygon(11, 6, 4, 3, black, 100, 0, true)
        plot(8, 4, black, 100)
endsprite

show_sprite(pacman, 0, 26, 0, 0, 0)
sync_queue

# Chomp across the screen (move_sprite auto-advances cels)
for v_x in (0, 50, 1)
    move_sprite(pacman, v_x, 26, 0)
    rest(0.05)
endfor v_x

sync_queue
rest(1)

hide_sprite(pacman, 0)
dispose_sprite(pacman, 0)
sync_queue

print("TEST COMPLETE: Pac-Man cel animation")
