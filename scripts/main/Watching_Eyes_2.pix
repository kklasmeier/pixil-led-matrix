    v_c = 30
    call eyes_to
    rest(0.6)
    call set_rest
}

# Z that floats up and fades (size v_zs at v_zx, v_zy)
def draw_z {
    draw_line(v_zx, v_zy, v_zx + v_zs, v_zy, light_gray, 80, 2600, fade)
    draw_line(v_zx + v_zs, v_zy, v_zx, v_zy + v_zs, light_gray, 80, 2600, fade)
    draw_line(v_zx, v_zy + v_zs, v_zx + v_zs, v_zy + v_zs, light_gray, 80, 2600, fade)
}

# 14: nods off, jerks awake, nods off for real (breathing + Z's), then wakes up
def act_sleep {
    v_bb = 3
    v_bo = 1
    call brows_to
    for v_k in (2, 7, 1)
        v_c = v_k
        v_dy = int(v_k / 3)
        call eyes_to
        rest(0.14)
    endfor v_k
    rest(0.4)
    # Jolt awake
    v_bb = 0
    v_bo = -3
    call brows_to
    v_c = 0
    v_dy = -1
    call eyes_to
    rest(0.5)
    v_dy = 0
    v_bb = 3
    v_bo = 1
    call brows_to
    v_c = 4
    call eyes_to
    rest(0.7)
    # Really falling asleep this time
    for v_k in (4, 7, 1)
        v_c = v_k
        call eyes_to
        rest(0.22)
    endfor v_k
    v_bb = 0
    v_bo = 1
    call brows_to
    v_c = 7
    v_n = random(4, 6, 0)
    for v_z in (0, v_n, 1)
        v_dy = 1
        call eyes_to
        v_zi = fmod(v_z, 3)
        v_zx = 49 + v_zi * 4
        v_zy = 22 - v_zi * 7
        v_zs = 3 + v_zi
        call draw_z
        rest(0.9)
        v_dy = 0
        call draw_face
        rest(0.7)
    endfor v_z
    # Wake up
    v_w = random(1, 100, 0)
    if v_w <= 50 then
        v_dy = -2
        v_bb = 0
        v_bo = -3
        call brows_to
        v_c = 29
        call eyes_to
        rest(0.5)
        v_dy = 0
        v_c = 0
        call eyes_to
        rest(0.4)
    else
        v_dy = 0
        v_bb = 3
        v_bo = 1
        call brows_to
        for v_k in (8, 12, 1)
            v_c = v_k
            call eyes_to
            rest(0.15)
        endfor v_k
        rest(0.3)
    endif
    # Force a mood change after waking up
    v_acts = v_mood_len
    call set_rest
}

