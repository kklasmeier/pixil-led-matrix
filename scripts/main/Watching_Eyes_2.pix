    for v_r in (0, 2, 1)
        for v_i in (1, 8, 1)
            v_c = v_look_cels[v_i]
            v_dx = random(-1, 1, 0)
            call eyes_to
            rest(0.05 + v_r * 0.04)
        endfor v_i
