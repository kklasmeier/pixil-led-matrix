# Watching Eyes v4 - Personality Edition
#
# What's new vs v3:
#   - EYEBROWS (two extra sprites) so every expression reads clearly
#   - MOODS (neutral / happy / sleepy / grumpy / curious) that drift over time.
#     Each mood has its own resting face, blink speed, pacing and action menu.
#   - New expressions: happy ^ ^, content, heart eyes, sparkle, shocked,
#     teary, scrunched, knocked-out X
#   - New behaviors: eye roll, side-eye, double take, startle, sneeze, yawn,
#     nodding off and sleeping (with floating Z's), giggle, glare, dizzy spin,
#     sad pout, love, and a FLY that the eyes chase, go cross-eyed over, and
#     either swat or lose
#   - Idle glances while waiting so the eyes never feel frozen

throttle(0.1)

# Cap display refresh at 60 FPS
fps(60)

# ============================================================
# EYE SPRITE (16x16)
#   0-25  : same as v3 (blink cycle, wide, look-around, squint look)
#   26    : happy ^ eye
#   27    : heart eye
#   28    : sparkle / excited eye
#   29    : shocked (tiny pupil, wide)
#   30    : sad / teary
#   31    : scrunched shut (sneeze)
#   32    : knocked-out X
#   33    : content (curved-down smile eye)
#   34-37 : normal-open look left / right / down / up
# ============================================================

define_sprite(eye, 16, 16)

    sprite_cel(0)
        draw_ellipse(8, 8, 7, 7, white, 100, true, 0)
        draw_circle(8, 8, 4, sky_blue, 100, true)
        draw_circle(8, 8, 2, black, 100, true)
        plot(6, 5, white, 100)
        plot(7, 5, white, 80)

    sprite_cel(1)
        draw_ellipse(8, 8, 7, 6, white, 100, true, 0)
