    v_bo = -3
    call brows_to
    v_dy = -2
    call draw_face
    rest(0.9)
    v_dy = 0
    v_bo = 0
    call brows_to
    for v_k in (8, 12, 1)
        v_c = v_k
        call eyes_to
        rest(0.1)
    endfor v_k
    call blink
}

