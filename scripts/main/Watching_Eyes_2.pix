        for v_i in (1, 4, 1)
            v_c = v_squint_cels[v_i]
            call eyes_to
            rest(v_look_speed + 0.1)
        endfor v_i
    else
        for v_i in (4, 1, -1)
            v_c = v_squint_cels[v_i]
            call eyes_to
            rest(v_look_speed + 0.1)
        endfor v_i
    endif
    v_c = 4
    call eyes_to
    rest(0.15)
    v_c = 3
    call eyes_to
    rest(0.05)
    v_c = 2
    call eyes_to
    rest(0.05)
    call set_rest
}

# 5: suspicious side-eye with one skeptical raised brow
def act_sideeye {
