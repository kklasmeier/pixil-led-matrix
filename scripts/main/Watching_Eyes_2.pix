        plot(6, 4, white, 100)
        plot(7, 4, white, 80)

endsprite

# ============================================================
# EYEBROW SPRITES (16x6). Same cel numbers on both sides:
#   0 neutral arch   1 angry   2 sad/worried   3 flat (unamused)   4 happy arch
# Left brow: inner end is on the right. Right brow is the mirror.
# (Change "tan" to any color name to recolor the brows.)
# ============================================================

define_sprite(brow_l, 16, 6)
    sprite_cel(0)
        draw_line(1, 4, 7, 2, tan, 100)
        draw_line(7, 2, 14, 3, tan, 100)
        draw_line(1, 5, 7, 3, tan, 50)
        draw_line(7, 3, 14, 4, tan, 50)
    sprite_cel(1)
        draw_line(1, 0, 14, 4, tan, 100)
        draw_line(1, 1, 14, 5, tan, 100)
    sprite_cel(2)
        draw_line(1, 4, 14, 0, tan, 100)
        draw_line(1, 5, 14, 1, tan, 100)
    sprite_cel(3)
        draw_line(1, 3, 14, 3, tan, 100)
        draw_line(1, 4, 14, 4, tan, 100)
    sprite_cel(4)
        draw_arc(1, 4, 14, 4, 3, tan, 100)
        draw_arc(1, 5, 14, 5, 3, tan, 60)
endsprite

define_sprite(brow_r, 16, 6)
    sprite_cel(0)
        draw_line(1, 3, 8, 2, tan, 100)
        draw_line(8, 2, 14, 4, tan, 100)
        draw_line(1, 4, 8, 3, tan, 50)
        draw_line(8, 3, 14, 5, tan, 50)
    sprite_cel(1)
        draw_line(14, 0, 1, 4, tan, 100)
        draw_line(14, 1, 1, 5, tan, 100)
    sprite_cel(2)
        draw_line(14, 4, 1, 0, tan, 100)
        draw_line(14, 5, 1, 1, tan, 100)
    sprite_cel(3)
        draw_line(1, 3, 14, 3, tan, 100)
        draw_line(1, 4, 14, 4, tan, 100)
    sprite_cel(4)
        draw_arc(1, 4, 14, 4, 3, tan, 100)
        draw_arc(1, 5, 14, 5, 3, tan, 60)
endsprite

# ============================================================
# FLY SPRITE (5x4) - two wing cels, flaps automatically when moved
# ============================================================

define_sprite(fly, 5, 4)
    sprite_cel(0)
        plot(2, 1, gray, 100)
        plot(2, 2, gray, 100)
        plot(1, 0, white, 100)
        plot(3, 0, white, 100)
    sprite_cel(1)
        plot(2, 1, gray, 100)
        plot(2, 2, gray, 100)
        plot(0, 1, white, 100)
        plot(4, 1, white, 100)
endsprite

