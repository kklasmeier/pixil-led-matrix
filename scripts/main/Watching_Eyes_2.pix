    v_dy = -3
    call draw_face
    rest(0.1)
    v_dx = 1
    for v_k in (0, 7, 1)
        v_dx = v_dx * -1
        call draw_face
        rest(0.05)
    endfor v_k
    v_dx = 0
    v_dy = 0
    v_c = 0
    call eyes_to
    rest(0.6)
    call blink
}

# Fly helpers ---------------------------------------------------------
# Eyes track the fly (cross-eyed when it is near the nose)
def fly_frame {
    v_fdx = v_fx + 2 - 32
    v_fdy = v_fy + 2 - 32
    v_fdist = sqrt(v_fdx * v_fdx + v_fdy * v_fdy)
    if v_fdist < 7 then
        v_cel_l = 18
        v_cel_r = 22
    else
        v_ang = atan2(v_fdy, v_fdx)
        v_idx = int(round(v_ang / 0.7854)) + 4
        v_cel_l = v_dir_cels[v_idx]
        v_cel_r = v_cel_l
    endif
    begin_frame(true)
        call place_face
        move_sprite(fly, v_fx, v_fy, 0)
    end_frame
}

# 9: a fly spirals in, lands between the eyes, then gets swatted or escapes
def act_fly {
    v_bb = 0
    v_bo = -2
    call brows_to
    v_fa = random(0, 6, 2)
    v_fx = int(max(0, min(59, 30 + cos(v_fa) * 34)))
    v_fy = int(max(0, min(60, 28 + sin(v_fa) * 27)))
    show_sprite(fly, v_fx, v_fy, 0, 5, 0)
    for v_t in (0, 80, 1)
        v_fa = v_fa + 0.28
        v_fr = 36 - v_t * 0.42
        v_jx = random(-2, 2, 0)
        v_jy = random(-2, 2, 0)
        v_fx = 30 + cos(v_fa) * v_fr + v_jx
        v_fy = 28 + sin(v_fa) * v_fr * 0.8 + v_jy
        v_fx = int(max(0, min(59, v_fx)))
        v_fy = int(max(0, min(60, v_fy)))
        call fly_frame
        rest(0.03)
    endfor v_t
    # Landed on the nose: concentrate, cross-eyed
    v_fx = 30
    v_fy = 27
    v_bb = 1
    v_bo = 0
    call brows_to
    for v_k in (0, 7, 1)
        call fly_frame
        rest(0.12)
    endfor v_k
    v_o = random(1, 100, 0)
    if v_o <= 50 then
        # Swat!
        v_bb = 1
        v_bo = 1
        call brows_to
        v_c = 4
        call eyes_to
        rest(0.5)
        v_c = 31
        v_dy = 1
        call eyes_to
        hide_sprite(fly)
        draw_circle(31, 27, 4, white, 100, false, 350, fade)
        rest(0.4)
        v_dy = 0
        v_bb = 4
        v_bo = -1
        call brows_to
        v_c = 26
        call eyes_to
        rest(1.3)
    else
        # The fly escapes
        v_sgn = random(0, 1, 0) * 2 - 1
        for v_t in (0, 24, 1)
            v_fx = int(30 + v_t * 1.2 * v_sgn)
            v_fy = int(27 - v_t + sin(v_t * 0.9) * 3)
            call fly_frame
            rest(0.04)
        endfor v_t
        hide_sprite(fly)
        rest(0.4)
        v_bb = 3
        v_bo = 1
        call brows_to
        v_c = 4
        call eyes_to
        rest(0.8)
    endif
    hide_sprite(fly)
    call set_rest
}

