# Idle glances while waiting ---------------------------------------------
def glance_pick {
    v_g = random(0, 3, 0)
    if v_rest_cel == 0 then
        v_gc = v_glance_wide[v_g]
    elseif v_rest_cel == 3 then
        v_gc = v_glance_sq[v_g]
    else
        v_gc = v_glance_norm[v_g]
    endif
}

def idle_glance {
    call glance_pick
    v_c = v_gc
    call eyes_to
    rest(0.5 + random(0, 0.7, 2))
    v_g2 = random(1, 100, 0)
    if v_g2 <= 30 then
        call glance_pick
        v_c = v_gc
        call eyes_to
        rest(0.4 + random(0, 0.5, 2))
    endif
    call set_rest
}

# ============================================================
# START UP
# ============================================================

show_sprite(eye, v_left_x, v_eye_y, 0, 0, 1)
show_sprite(eye, v_right_x, v_eye_y, 1, 0, 1)
show_sprite(brow_l, v_left_x, v_brow_y, 0, 1, 0)
show_sprite(brow_r, v_right_x, v_brow_y, 0, 1, 0)

call apply_mood
sync_queue
rest(1)

# ============================================================
# MAIN LOOP
# ============================================================

while 1 == 1 then

    # Wait, with occasional idle glances so the eyes feel alive
    v_wait_left = v_wait_base + random(0, v_wait_var, 2)
    while v_wait_left > 0 then
        v_gr = random(1, 100, 0)
        if v_gr <= v_glance_chance then
            call idle_glance
        endif
        rest(0.4)
        v_wait_left = v_wait_left - 0.4
    endwhile

    # Pick an action from the current mood's menu
    v_slot = random(0, 9, 0)
    v_action = v_menu[v_mood * 10 + v_slot]

    if v_action == 1 then
        call act_blink
    elseif v_action == 2 then
        call act_wink
    elseif v_action == 3 then
        call act_lookaround
    elseif v_action == 4 then
        call act_squint
    elseif v_action == 5 then
        call act_sideeye
    elseif v_action == 6 then
        call act_eyeroll
    elseif v_action == 7 then
        call act_doubletake
    elseif v_action == 8 then
        call act_startle
    elseif v_action == 9 then
        call act_fly
    elseif v_action == 10 then
        call act_love
    elseif v_action == 11 then
        call act_dizzy
    elseif v_action == 12 then
        call act_sneeze
    elseif v_action == 13 then
        call act_pout
    elseif v_action == 14 then
        call act_sleep
    elseif v_action == 15 then
        call act_yawn
    elseif v_action == 16 then
        call act_giggle
    elseif v_action == 17 then
        call act_glare
    elseif v_action == 18 then
        call act_surprise
    else
        call act_drowsy
    endif

    # Mood drifts after a handful of actions
    v_acts = v_acts + 1
    if v_acts >= v_mood_len then
        call change_mood
    endif

endwhile
