    v_bb = 2
    v_bo = 0
    call brows_to
    v_c = 32
    v_dx = 2
    call eyes_to
    for v_k in (0, 5, 1)
        v_dx = v_dx * -1
        call draw_face
        rest(0.12)
    endfor v_k
    v_dx = 0
    call draw_face
    rest(0.4)
    call blink
}

# 12: sneeze - build-up, ACHOO, sheepish recovery
def act_sneeze {
    v_bb = 3
    v_bo = 1
