# ============================================================
# STATE
# ============================================================

v_left_x = 16
v_right_x = 34
v_eye_y = 24
v_brow_y = 18

v_dx = 0
v_dy = 0
v_cel_l = 1
v_cel_r = 1
v_bcl = 0
v_bcr = 0
v_boff_l = 0
v_boff_r = 0

v_c = 1
v_bb = 0
v_bo = 0

v_rest_cel = 1
v_rest_brow = 0
v_rest_boff = 0

v_mood = 0
v_acts = 0
v_mood_len = 6
v_wait_base = 2.0
v_wait_var = 2.5
v_blink_speed = 0.001
v_look_speed = 0.15
v_glance_chance = 25

# ============================================================
# CORE PROCEDURES
# ============================================================

# Move all four sprites to the current state variables
def place_face {
    v_lx = v_left_x + v_dx
    v_rx = v_right_x + v_dx
    v_ey = v_eye_y + v_dy
    v_byl = v_brow_y + v_dy + v_boff_l
    v_byr = v_brow_y + v_dy + v_boff_r
    move_sprite(eye, v_lx, v_ey, 0, v_cel_l)
    move_sprite(eye, v_rx, v_ey, 1, v_cel_r)
    move_sprite(brow_l, v_lx, v_byl, 0, v_bcl)
    move_sprite(brow_r, v_rx, v_byr, 0, v_bcr)
}

def draw_face {
    begin_frame(true)
        call place_face
    end_frame
}

# Set both eyes to cel v_c and draw
def eyes_to {
    v_cel_l = v_c
    v_cel_r = v_c
    call draw_face
}

# Set both brows to cel v_bb at offset v_bo (does not draw)
def brows_to {
    v_bcl = v_bb
    v_bcr = v_bb
    v_boff_l = v_bo
    v_boff_r = v_bo
}

# Return to the resting face for the current mood
def set_rest {
    v_dx = 0
    v_dy = 0
    if v_mood == 0 then
        v_rest_cel = 1
        v_rest_brow = 0
        v_rest_boff = 0
    elseif v_mood == 1 then
        v_rest_cel = 1
        v_rest_brow = 4
        v_rest_boff = -1
    elseif v_mood == 2 then
        v_rest_cel = 3
        v_rest_brow = 3
        v_rest_boff = 1
    elseif v_mood == 3 then
        v_rest_cel = 3
        v_rest_brow = 1
        v_rest_boff = 1
    else
        v_rest_cel = 0
        v_rest_brow = 0
        v_rest_boff = -2
    endif
    v_c = v_rest_cel
    v_bb = v_rest_brow
    v_bo = v_rest_boff
    call brows_to
    call eyes_to
}

# Apply pacing for the current mood, then show its resting face
def apply_mood {
    if v_mood == 0 then
        v_wait_base = 2.0
        v_wait_var = 2.5
        v_blink_speed = 0.001
        v_glance_chance = 25
    elseif v_mood == 1 then
        v_wait_base = 1.6
        v_wait_var = 2.0
        v_blink_speed = 0.001
        v_glance_chance = 25
    elseif v_mood == 2 then
        v_wait_base = 3.5
        v_wait_var = 3.0
        v_blink_speed = 0.05
        v_glance_chance = 8
    elseif v_mood == 3 then
        v_wait_base = 2.5
        v_wait_var = 2.0
        v_blink_speed = 0.002
        v_glance_chance = 15
    else
        v_wait_base = 1.0
        v_wait_var = 1.6
        v_blink_speed = 0.001
        v_glance_chance = 40
    endif
    call set_rest
}

def change_mood {
    v_mp = random(0, 6, 0)
    v_mood = v_mood_pick[v_mp]
    v_acts = 0
    v_mood_len = random(4, 7, 0)
    call apply_mood
}

# Smooth blink, honoring the mood's blink speed
def blink {
    for v_b in (0, 5, 1)
        v_c = v_blink_seq[v_b]
        call eyes_to
        if v_b == 2 then
            rest(0.03)
        else
            rest(v_blink_speed)
        endif
    endfor v_b
    call set_rest
}

# ============================================================
# ACTIONS
# ============================================================

# 1: blink (15% chance of a double blink)
def act_blink {
    call blink
    v_d = random(1, 100, 0)
    if v_d <= 15 then
        rest(0.1)
        call blink
    endif
}

# Helper for winks: v_w = which eye winks, v_wc = its cel, v_oc = other eye cel
def wink_draw {
    if v_w == 0 then
        v_cel_l = v_wc
        v_cel_r = v_oc
    else
        v_cel_r = v_wc
        v_cel_l = v_oc
    endif
    call draw_face
}

# 2: cheeky wink - the other eye sparkles and its brow lifts
def act_wink {
    v_w = random(0, 1, 0)
    v_oc = v_rest_cel
    for v_k in (0, 2, 1)
        v_wc = v_blink_seq[v_k]
        call wink_draw
        rest(0.01)
    endfor v_k
    v_oc = 28
    if v_w == 0 then
        v_boff_l = v_rest_boff + 2
        v_boff_r = v_rest_boff - 2
        v_bcr = 0
    else
        v_boff_r = v_rest_boff + 2
        v_boff_l = v_rest_boff - 2
        v_bcl = 0
    endif
    call wink_draw
    rest(0.45)
    v_oc = v_rest_cel
    for v_k in (3, 5, 1)
        v_wc = v_blink_seq[v_k]
        call wink_draw
        rest(0.01)
    endfor v_k
    call set_rest
}

# 3: wide-eyed look around (random direction), brows up
def act_lookaround {
    v_bb = 0
    v_bo = -2
    call brows_to
    v_c = 0
    call eyes_to
    rest(0.2)
    v_dirn = random(0, 1, 0)
    if v_dirn == 0 then
        for v_i in (1, 8, 1)
            v_c = v_look_cels[v_i]
            call eyes_to
            rest(v_look_speed)
        endfor v_i
    else
        for v_i in (8, 1, -1)
            v_c = v_look_cels[v_i]
            call eyes_to
            rest(v_look_speed)
        endfor v_i
    endif
    v_c = 0
    call eyes_to
    rest(0.2)
    call blink
}

# 4: squinty look left-right
def act_squint {
    v_bb = 3
    v_bo = 1
    call brows_to
