# Pachinko Machine Simulation V2
# Same 24 shuffled boards as V1; motion uses generic particle primitives.
# Rubber, metal, and soft-polymer balls have visibly different elasticity.
# Runs forever, cycling through 24 board designs
# Boards are shuffled at startup, then repeat in same order forever

# ========== PERFORMANCE ==========
throttle(0)

# Cap display refresh at 60 FPS (rgb_matrix_lib; fps(0) = unlimited)
fps(30)


# ========== CONFIGURABLE SETTINGS ==========
v_num_balls = 80              # Total number of balls to drop per board
v_max_balls_active = 10       # Match V1 density; V2 still handles 80 total
v_gravity = 0.15              # Downward acceleration per frame
v_drop_interval = 5          # Match V1 pacing; avoids a waterfall effect
v_total_boards = 24           # Total number of board designs
v_force_board = -1            # -1 = normal shuffle; 0-23 = always use that board (testing)

# ========== DISPLAY CONSTANTS ==========
v_left_wall = 3
v_right_wall = 60
v_exit_y = 64

# ========== COLOR SYSTEM ==========
v_wall_brightness = 40
v_peg_brightness = 70

# ========== PHYSICS CONSTANTS ==========
# Match draw_circle(..., radius 1) pegs + 1px ball sprite (center-to-center at contact ~1.5)
v_peg_radius = 1
v_ball_radius = 0.5
v_max_velocity = 3            # Maximum ball speed in any direction
v_neg_max_velocity = -3       # Pre-computed negative max velocity

# ========== BALL ARRAYS (24 slots, indices 0..23) ==========
create_array(v_ball_x, 24, numeric)
create_array(v_ball_y, 24, numeric)
create_array(v_ball_vx, 24, numeric)
create_array(v_ball_vy, 24, numeric)
create_array(v_ball_active, 24, numeric)
create_array(v_ball_material, 24, numeric)
create_array(v_ball_restitution, 24, numeric)
create_array(v_ball_kick, 24, numeric)
create_array(v_peg_hit, 24, numeric)

# ========== PEG ARRAYS ==========
create_array(v_peg_x, 45)
create_array(v_peg_y, 45)
v_num_pegs = 0

# ========== BAND ARRAYS ==========
create_array(v_band_start, 8)
create_array(v_band_end, 8)

# ========== BOARD ORDER ARRAY ==========
create_array(v_board_order, 24)

# Initialize board order: 0, 1, 2, ... 23
for v_i in (0, 23, 1)
    v_board_order[v_i] = v_i
endfor v_i

# Fisher-Yates shuffle (skipped when v_force_board >= 0)
if v_force_board < 0 then
    for v_i in (23, 1, -1)
        v_j = random(0, v_i, 0)
        v_temp = v_board_order[v_i]
        v_board_order[v_i] = v_board_order[v_j]
        v_board_order[v_j] = v_temp
    endfor v_i
endif

# ========== DEFINE MATERIAL BALL SPRITE ==========
define_sprite(ball_sprite, 1, 1)
    # Cel 0: rubber (cyan, lively)
    sprite_cel(0)
    plot(0, 0, cyan, 100)
    # Cel 1: metal (white, medium bounce)
    sprite_cel(1)
    plot(0, 0, white, 100)
    # Cel 2: soft polymer (orange, damped)
    sprite_cel(2)
    plot(0, 0, orange, 100)
endsprite

# ========== OUTER LOOP - RUNS FOREVER ==========
v_board_index = 0

while 1 == 1 then
    
    if v_force_board >= 0 then
        v_board_type = v_force_board
    else
        v_board_type = v_board_order[v_board_index]
    endif
    
    # ========== RESET STATE ==========
    v_balls_dropped = 0
    v_frame_count = 0
    v_active_count = 0
    
    for v_i in (0, 23, 1)
        v_was_active = v_ball_active[v_i]
        if v_was_active > 0 then
            hide_sprite(ball_sprite, v_i)
        endif
        v_ball_active[v_i] = 0
    endfor v_i
    
    for v_i in (0, 7, 1)
        v_band_start[v_i] = 0
        v_band_end[v_i] = -1
    endfor v_i
    
    v_num_pegs = 0
    
    # ========== BOARD 0: CLASSIC FUNNEL ==========
    if v_board_type == 0 then
