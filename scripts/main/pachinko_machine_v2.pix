    # ========== BOARD 23: SPARSE FIELD ==========
    if v_board_type == 23 then
        v_peg_x[0] = 32
        v_peg_y[0] = 12
        v_band_start[1] = 0
        v_band_end[1] = 0
        v_peg_x[1] = 18
        v_peg_y[1] = 28
        v_peg_x[2] = 46
        v_peg_y[2] = 28
        v_band_start[3] = 1
        v_band_end[3] = 2
        v_peg_x[3] = 12
        v_peg_y[3] = 44
        v_peg_x[4] = 32
        v_peg_y[4] = 42
        v_peg_x[5] = 52
        v_peg_y[5] = 44
        v_band_start[5] = 3
        v_band_end[5] = 5
        v_peg_x[6] = 20
        v_peg_y[6] = 54
        v_peg_x[7] = 38
        v_peg_y[7] = 52
        v_peg_x[8] = 50
        v_peg_y[8] = 55
        v_band_start[6] = 6
        v_band_end[6] = 8
        v_num_pegs = 9
        v_wall_color = 48
        v_peg_color = 88
    endif
    
    # ========== DRAW STATIC BACKGROUND (once per board; not cleared each frame) ==========
    v_peg_end = v_num_pegs - 1
    
    clear()
    begin_frame(false)
    
    draw_line(0, 0, 0, 63, v_wall_color, 10)
    draw_line(1, 0, 1, 63, v_wall_color, 20)
    draw_line(2, 0, 2, 63, v_wall_color, 30)
    draw_line(v_left_wall, 0, v_left_wall, 63, v_wall_color, v_wall_brightness)
    
    draw_line(63, 0, 63, 63, v_wall_color, 10)
    draw_line(62, 0, 62, 63, v_wall_color, 20)
    draw_line(61, 0, 61, 63, v_wall_color, 30)
    draw_line(v_right_wall, 0, v_right_wall, 63, v_wall_color, v_wall_brightness)
    
    for v_p in (0, v_peg_end, 1)
        v_px = v_peg_x[v_p]
        v_py = v_peg_y[v_p]
        draw_circle(v_px, v_py, 1, v_peg_color, v_peg_brightness, true)
    endfor v_p
    
    end_frame
    
    # ========== BALL DROP LOOP (preserve static board; batch sprites per frame) ==========
    v_running = 1
    while v_running == 1 then
        
        begin_frame(true)
        
        v_should_drop = v_frame_count % v_drop_interval
        if v_should_drop == 0 then
            if v_balls_dropped < v_num_balls then
                if v_active_count < v_max_balls_active then
                    v_found_slot = -1
                    for v_slot in (0, 23, 1)
                        if v_found_slot == -1 then
                            v_slot_status = v_ball_active[v_slot]
                            if v_slot_status < 1 then
                                v_found_slot = v_slot
                            endif
                        endif
                    endfor v_slot
                    
                    if v_found_slot >= 0 then
                        v_ball_active[v_found_slot] = 1
                        v_ball_x[v_found_slot] = random(v_left_wall + 5, v_right_wall - 5, 1)
                        v_ball_y[v_found_slot] = 2
                        v_ball_vx[v_found_slot] = random(-0.5, 0.5, 2)
                        v_ball_vy[v_found_slot] = 0

                        # Material controls both bounce energy and sideways life.
                        v_material = random(0, 2, 0)
                        v_ball_material[v_found_slot] = v_material
                        if v_material == 0 then
                            # Rubber: springy and lively.
                            v_ball_restitution[v_found_slot] = 0.95
                            v_ball_kick[v_found_slot] = 0.7
                        elseif v_material == 1 then
                            # Metal: firm but less elastic than rubber.
                            v_ball_restitution[v_found_slot] = 0.72
                            v_ball_kick[v_found_slot] = 0.4
                        else
                            # Soft polymer: absorbs most impact energy.
                            v_ball_restitution[v_found_slot] = 0.42
                            v_ball_kick[v_found_slot] = 0.18
                        endif

                        v_balls_dropped = v_balls_dropped + 1
                        v_active_count = v_active_count + 1
                        v_bx = floor(v_ball_x[v_found_slot])
                        v_by = floor(v_ball_y[v_found_slot])
                        show_sprite(ball_sprite, v_bx, v_by, v_found_slot, 0, v_material)
                    endif
                endif
            endif
        endif
        
        # ========== UPDATE BALLS (generic particle primitives) ==========
        # Bounds left/right 4.5 and 58.5 + radius 0.5 => center limits 5 and 58
        particle_integrate(v_ball_x, v_ball_y, v_ball_vx, v_ball_vy, v_ball_active, 0, v_gravity, 1, 0, 24)
        particle_collide_bounds(v_ball_x, v_ball_y, v_ball_vx, v_ball_vy, v_ball_active, 4.5, 58.5, -1000, 1000, v_ball_restitution, v_ball_radius)
        particle_collide_static_circles(v_ball_x, v_ball_y, v_ball_vx, v_ball_vy, v_ball_active, v_peg_x, v_peg_y, v_ball_radius, v_peg_radius, v_ball_restitution, v_peg_hit, 24, v_num_pegs)

        v_active_count = 0
        for v_b in (0, 23, 1)
            v_is_active = v_ball_active[v_b]
            if v_is_active > 0 then
                if v_peg_hit[v_b] > 0 then
                    v_kick_limit = v_ball_kick[v_b]
                    v_rand_kick = random(-v_kick_limit, v_kick_limit, 2)
                    v_ball_vx[v_b] = v_ball_vx[v_b] + v_rand_kick
                endif

                if v_ball_vx[v_b] > v_max_velocity then
                    v_ball_vx[v_b] = v_max_velocity
                endif
                if v_ball_vx[v_b] < v_neg_max_velocity then
                    v_ball_vx[v_b] = v_neg_max_velocity
                endif
                if v_ball_vy[v_b] > v_max_velocity then
                    v_ball_vy[v_b] = v_max_velocity
                endif
                if v_ball_vy[v_b] < v_neg_max_velocity then
                    v_ball_vy[v_b] = v_neg_max_velocity
                endif

                if v_ball_y[v_b] > v_exit_y then
                    v_ball_active[v_b] = 0
                    hide_sprite(ball_sprite, v_b)
                else
                    v_bx_draw = floor(v_ball_x[v_b])
                    v_by_draw = floor(v_ball_y[v_b])
                    move_sprite(ball_sprite, v_bx_draw, v_by_draw, v_b, v_ball_material[v_b])
                    v_active_count = v_active_count + 1
                endif
            endif
        endfor v_b
        
        v_frame_count = v_frame_count + 1
        
        if v_balls_dropped >= v_num_balls then
            if v_active_count == 0 then
                v_running = 0
            endif
        endif
        
        end_frame
        
    endwhile
    
    # ========== NEXT BOARD ==========
    v_board_index = v_board_index + 1
    if v_board_index > 23 then
        v_board_index = 0
    endif
    
endwhile