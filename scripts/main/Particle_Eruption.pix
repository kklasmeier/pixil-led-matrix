# Particle Eruption v2
# Pixil owns settling, eruption timing, colors, and drawing. Particle
# primitives apply the eruption force, movement, drag, and wall collisions.

throttle(0)
fps(60)

v_num_particles = 10

create_array(v_px, v_num_particles, numeric)
create_array(v_py, v_num_particles, numeric)
create_array(v_vx, v_num_particles, numeric)
create_array(v_vy, v_num_particles, numeric)
create_array(v_ax, v_num_particles, numeric)
create_array(v_ay, v_num_particles, numeric)
create_array(v_active, v_num_particles, numeric)
create_array(v_burst_active, v_num_particles, numeric)
create_array(v_wall_hit, v_num_particles, numeric)
create_array(v_color, v_num_particles, string)
create_array(v_size, v_num_particles, numeric)
create_array(v_settled, v_num_particles, numeric)

create_array(v_burst_x, 1, numeric)
create_array(v_burst_y, 1, numeric)
v_burst_x[0] = 32
v_burst_y[0] = 63

for v_i in (0, v_num_particles - 1, 1)
    v_px[v_i] = random(5, 58, 0)
    v_py[v_i] = random(5, 30, 0)
    v_vx[v_i] = random(-20, 20, 10) / 10
    v_vy[v_i] = random(-5, 5, 10) / 10
    v_ax[v_i] = 0
    v_ay[v_i] = 0.1
    v_active[v_i] = 1
    v_burst_active[v_i] = 0
    v_settled[v_i] = 0

    v_color_idx = v_i % 3
    if v_color_idx == 0 then
        v_color[v_i] = "red"
    elseif v_color_idx == 1 then
        v_color[v_i] = "green"
    else
        v_color[v_i] = "blue"
    endif

    v_size[v_i] = random(1, 3, 0)
endfor v_i

v_gravity = 0.1
v_friction = 0.98
v_bounce = 0.8
v_settled_threshold = 0.3
v_settled_count = 0
v_explosion_timer = 0
v_max_explosion_interval = 100
v_min_explosion_interval = 15
v_next_explosion_interval = 100
v_exploding = 0
v_explosion_force = 2.5
v_frame_counter = 0

while true then
    v_frame_counter = v_frame_counter + 1
    v_settled_count = 0

    # Reset this frame's force arrays while checking for settled particles.
    for v_i in (0, v_num_particles - 1, 1)
        v_ax[v_i] = 0
        v_ay[v_i] = v_gravity
        v_burst_active[v_i] = 0
        if abs(v_vx[v_i]) < v_settled_threshold and abs(v_vy[v_i]) < v_settled_threshold and v_py[v_i] > 50 then
            v_settled_count = v_settled_count + 1
            v_settled[v_i] = 1
        endif
    endfor v_i

    if v_settled_count > v_num_particles / 2 and v_frame_counter > v_explosion_timer + v_min_explosion_interval then
        v_exploding = 1
        v_explosion_timer = v_frame_counter
        v_next_explosion_interval = random(v_min_explosion_interval, v_max_explosion_interval, 0)

        # Only settled or low particles receive the air puff.
        for v_i in (0, v_num_particles - 1, 1)
            if v_settled[v_i] == 1 or v_py[v_i] > 45 then
                v_burst_active[v_i] = 1
                v_settled[v_i] = 0
            endif
        endfor v_i

        # Negative strength pushes away. Strength 75 is the original
        # explosion_force * 30; softening 5 keeps the center under control.
        particle_apply_attractors(v_px, v_py, v_ax, v_ay, v_burst_active, v_burst_x, v_burst_y, -75, 1, 1, 5, 20, v_num_particles, 1)
    else
        v_exploding = 0
    endif

    particle_integrate(v_px, v_py, v_vx, v_vy, v_active, v_ax, v_ay, v_friction, 0, v_num_particles)
    particle_collide_bounds(v_px, v_py, v_vx, v_vy, v_active, 0, 64, 0, 64, v_bounce, v_size, v_wall_hit, v_num_particles)

    begin_frame
        draw_rectangle(0, 0, 64, 64, black, 20, true)

        if v_exploding == 1 then
            draw_circle(32, 63, 10, yellow, 80, true, 100)
            draw_circle(32, 63, 15, orange, 60, false, 150)
            draw_circle(32, 63, 20, red, 40, false, 200)
        endif

        for v_i in (0, v_num_particles - 1, 1)
            if v_settled[v_i] == 1 and v_exploding == 0 then
                draw_circle(v_px[v_i], v_py[v_i], v_size[v_i], v_color[v_i], 70, true)
            else
                draw_circle(v_px[v_i], v_py[v_i], v_size[v_i], v_color[v_i], 100, true)
                draw_circle(v_px[v_i], v_py[v_i], v_size[v_i] + 1, v_color[v_i], 50, false)
            endif
        endfor v_i

        draw_line(0, 63, 63, 63, white, 30)
    end_frame
endwhile
