# Tornado v2
# Same grow / mature / fade cycle and spiral-arm look as Tornado.pix.
# Ground debris uses particle_apply_attractors (inward pull + spin).
# Funnel dust stays polar in Pixil because that motion is a conveyor, not a well.

throttle(0)
fps(60)

v_center_x = 32
v_center_y = 32
v_tornado_strength = 0
v_max_strength = 100
v_growth_rate = 1
v_swirl = -3

v_num_particles = 20
create_array(v_particle_angle, v_num_particles, numeric)
create_array(v_particle_radius, v_num_particles, numeric)
create_array(v_particle_speed, v_num_particles, numeric)
create_array(v_particle_life, v_num_particles, numeric)

v_num_debris = 24
create_array(v_debris_x, v_num_debris, numeric)
create_array(v_debris_y, v_num_debris, numeric)
create_array(v_debris_vx, v_num_debris, numeric)
create_array(v_debris_vy, v_num_debris, numeric)
create_array(v_debris_ax, v_num_debris, numeric)
create_array(v_debris_ay, v_num_debris, numeric)
create_array(v_debris_active, v_num_debris, numeric)

create_array(v_well_x, 1, numeric)
create_array(v_well_y, 1, numeric)
v_well_x[0] = v_center_x
v_well_y[0] = v_center_y

v_inner_color = "dark_gray"
v_mid_color = "forest_green"
v_outer_color = "dark_brown"
v_debris_color = "brown"

for v_i in (0, v_num_particles - 1, 1)
    v_particle_angle[v_i] = random(0, 628, 0) / 100
    v_particle_radius[v_i] = random(30, 45, 0)
    v_particle_speed[v_i] = random(8, 15, 0) / 100
    v_particle_life[v_i] = random(100, 200, 0)
endfor v_i

for v_i in (0, v_num_debris - 1, 1)
    v_debris_x[v_i] = random(10, 54, 0)
    v_debris_y[v_i] = random(45, 58, 0)
    v_debris_vx[v_i] = 0
    v_debris_vy[v_i] = 0
    v_debris_ax[v_i] = 0
    v_debris_ay[v_i] = 0
    v_debris_active[v_i] = 1
endfor v_i

v_phase = 0
v_phase_timer = 0
v_spiral_offset = 0

while true then
    v_phase_timer = v_phase_timer + 1

    if v_phase == 0 then
        v_tornado_strength = v_tornado_strength + v_growth_rate
        if v_tornado_strength >= v_max_strength then
            v_phase = 1
            v_phase_timer = 0
        endif
    elseif v_phase == 1 then
        if v_phase_timer > 200 then
            v_phase = 2
            v_phase_timer = 0
        endif
    else
        v_tornado_strength = v_tornado_strength - v_growth_rate
        if v_tornado_strength <= 0 then
            v_tornado_strength = 0
            v_phase = 0
            v_phase_timer = 0
        endif
    endif

    v_spiral_offset = v_spiral_offset + 0.15
    if v_spiral_offset > 6.28318530718 then
        v_spiral_offset = v_spiral_offset - 6.28318530718
    endif

    v_strength_factor = v_tornado_strength / 100

    if v_tornado_strength > 10 then
        for v_i in (0, v_num_debris - 1, 1)
            v_debris_ax[v_i] = 0
            v_debris_ay[v_i] = 0
        endfor v_i
        v_pull_strength = v_tornado_strength * 0.002
        particle_apply_attractors(v_debris_x, v_debris_y, v_debris_ax, v_debris_ay, v_debris_active, v_well_x, v_well_y, v_pull_strength, 1, -1, 0, 10, v_num_debris, 1, v_swirl)
        particle_integrate(v_debris_x, v_debris_y, v_debris_vx, v_debris_vy, v_debris_active, v_debris_ax, v_debris_ay, 0, 0, v_num_debris)
        for v_i in (0, v_num_debris - 1, 1)
            v_dx = v_debris_x[v_i] - v_center_x
            v_dy = v_debris_y[v_i] - v_center_y
            v_d2 = v_dx * v_dx + v_dy * v_dy
            if v_d2 < 16 or v_debris_x[v_i] < 0 or v_debris_x[v_i] > 63 or v_debris_y[v_i] < 0 or v_debris_y[v_i] > 63 then
                v_debris_x[v_i] = random(10, 54, 0)
                v_debris_y[v_i] = random(45, 58, 0)
                v_debris_vx[v_i] = 0
                v_debris_vy[v_i] = 0
            endif
        endfor v_i
    endif

    begin_frame
        for v_arm in (0, 2, 1)
            v_arm_angle = v_spiral_offset + v_arm * 2.094
            for v_segment in (3, 25, 3)
                v_seg_angle = v_arm_angle + v_segment * 0.2
                v_seg_radius = v_segment * v_strength_factor
                v_x = v_center_x + v_seg_radius * cos(v_seg_angle)
                v_y = v_center_y + v_seg_radius * sin(v_seg_angle)
                if v_x >= 0 and v_x <= 63 and v_y >= 0 and v_y <= 63 then
                    if v_seg_radius < 8 then
                        plot(v_x, v_y, v_inner_color, 90 * v_strength_factor)
                    elseif v_seg_radius < 15 then
                        plot(v_x, v_y, v_mid_color, 70 * v_strength_factor)
                    else
                        plot(v_x, v_y, v_outer_color, 50 * v_strength_factor)
                    endif
                endif
            endfor v_segment
        endfor v_arm

        for v_i in (0, v_num_particles - 1, 1)
            v_particle_angle[v_i] = v_particle_angle[v_i] + v_particle_speed[v_i] * v_strength_factor
            v_particle_radius[v_i] = v_particle_radius[v_i] - 0.3 * v_strength_factor
            v_x = v_center_x + v_particle_radius[v_i] * cos(v_particle_angle[v_i])
            v_y = v_center_y + v_particle_radius[v_i] * sin(v_particle_angle[v_i])
            v_particle_life[v_i] = v_particle_life[v_i] - 1
            if v_particle_radius[v_i] < 3 or v_particle_life[v_i] <= 0 then
                v_particle_angle[v_i] = random(0, 628, 0) / 100
                v_particle_radius[v_i] = random(30, 45, 0)
                v_particle_life[v_i] = random(100, 200, 0)
            endif
            if v_x >= 0 and v_x <= 63 and v_y >= 0 and v_y <= 63 and v_particle_radius[v_i] > 3 then
                v_intensity = 60 + v_particle_radius[v_i]
                if v_intensity > 100 then
                    v_intensity = 100
                endif
                plot(v_x, v_y, v_outer_color, v_intensity)
            endif
        endfor v_i

        if v_tornado_strength > 10 then
            v_debris_bright = 80
        else
            v_debris_bright = 60
        endif
        for v_i in (0, v_num_debris - 1, 1)
            plot(v_debris_x[v_i], v_debris_y[v_i], v_debris_color, v_debris_bright)
        endfor v_i

        if v_tornado_strength > 50 then
            v_eye_size = 2 + v_tornado_strength / 50
            draw_circle(v_center_x, v_center_y, v_eye_size, black, 80, true)
            draw_circle(v_center_x, v_center_y, v_eye_size, gray, 40, false)
        endif
    end_frame
endwhile
