# Bouncing Pixels v2
# Same look as Bouncing_Pixels.pix. Native integrate/bounds handle motion;
# Pixil keeps energy boosts, the left/right inward nudge, trails, and colors.

throttle(0)
fps(60)

v_num_pixels = 5
v_bounce = 0.95
v_gravity = 0.1
v_boost_threshold = 1.0

create_array(v_x, v_num_pixels, numeric)
create_array(v_y, v_num_pixels, numeric)
create_array(v_vx, v_num_pixels, numeric)
create_array(v_vy, v_num_pixels, numeric)
create_array(v_active, v_num_pixels, numeric)
create_array(v_wall_hit, v_num_pixels, numeric)
create_array(v_trail, v_num_pixels, numeric)
create_array(v_color, v_num_pixels, string)
create_array(v_palette, 6, string)

v_palette[0] = "cyan"
v_palette[1] = "magenta"
v_palette[2] = "yellow"
v_palette[3] = "blue"
v_palette[4] = "green"
v_palette[5] = "red"

v_i = 0
while v_i < v_num_pixels then
    v_x[v_i] = random(10, 53, 0)
    v_y[v_i] = random(10, 53, 0)
    v_vx[v_i] = random(-3, 3, 1)
    v_vy[v_i] = random(-4, -2, 1)
    v_active[v_i] = 1
    v_trail[v_i] = random(2, 4, 0)
    v_c = random(0, 5, 0)
    v_color[v_i] = v_palette[v_c]
    v_i = v_i + 1
endwhile

while true then
    v_i = 0
    while v_i < v_num_pixels then
        # Original boost used post-gravity vy, then moved. Subtract gravity
        # here so particle_integrate's ay restores the same launch speed.
        if v_y[v_i] > 50 and abs(v_vy[v_i] + v_gravity) < v_boost_threshold then
            v_vy[v_i] = random(-4, -2, 1) - v_gravity
            v_vx[v_i] = random(-3, 3, 1)
        endif
        v_i = v_i + 1
    endwhile

    particle_integrate(v_x, v_y, v_vx, v_vy, v_active, 0, v_gravity, 1, 0, v_num_pixels)
    particle_collide_bounds(v_x, v_y, v_vx, v_vy, v_active, 0, 63, 0, 63, v_bounce, 0, v_wall_hit, v_num_pixels)

    begin_frame
        v_i = 0
        while v_i < v_num_pixels then
            if v_wall_hit[v_i] == 1 then
                if v_x[v_i] <= 0 then
                    v_vx[v_i] = v_vx[v_i] + 0.1
                endif
                if v_x[v_i] >= 63 then
                    v_vx[v_i] = v_vx[v_i] - 0.1
                endif
            endif

            plot(v_x[v_i], v_y[v_i], v_color[v_i], 99, 100)

            v_t = 1
            while v_t < v_trail[v_i] then
                v_trail_x = v_x[v_i] - (v_vx[v_i] * v_t)
                v_trail_y = v_y[v_i] - (v_vy[v_i] * v_t)
                if v_trail_x >= 0 and v_trail_x < 64 and v_trail_y >= 0 and v_trail_y < 64 then
                    v_trail_bright = 80 - (v_t * 20)
                    if v_trail_bright < 20 then
                        v_trail_bright = 20
                    endif
                    plot(v_trail_x, v_trail_y, v_color[v_i], v_trail_bright, 100)
                endif
                v_t = v_t + 1
            endwhile

            v_i = v_i + 1
        endwhile
    end_frame
endwhile
