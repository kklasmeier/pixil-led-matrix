# ---------------- chunk switching helpers ----------------
# v_ck = chunk to show, v_lc = local cel (0-8), v_cur = chunk currently shown
def show_chunk {
    if v_ck == 0 then
        show_sprite(earth0, 6, 6, 0, 0, v_lc)
    elseif v_ck == 1 then
        show_sprite(earth1, 6, 6, 0, 0, v_lc)
    elseif v_ck == 2 then
        show_sprite(earth2, 6, 6, 0, 0, v_lc)
    elseif v_ck == 3 then
        show_sprite(earth3, 6, 6, 0, 0, v_lc)
    elseif v_ck == 4 then
        show_sprite(earth4, 6, 6, 0, 0, v_lc)
    elseif v_ck == 5 then
        show_sprite(earth5, 6, 6, 0, 0, v_lc)
    elseif v_ck == 6 then
        show_sprite(earth6, 6, 6, 0, 0, v_lc)
    else
        show_sprite(earth7, 6, 6, 0, 0, v_lc)
    endif
}

def hide_chunk {
    if v_cur == 0 then
        hide_sprite(earth0, 0)
    elseif v_cur == 1 then
        hide_sprite(earth1, 0)
    elseif v_cur == 2 then
        hide_sprite(earth2, 0)
    elseif v_cur == 3 then
        hide_sprite(earth3, 0)
    elseif v_cur == 4 then
        hide_sprite(earth4, 0)
    elseif v_cur == 5 then
        hide_sprite(earth5, 0)
    elseif v_cur == 6 then
        hide_sprite(earth6, 0)
    else
        hide_sprite(earth7, 0)
    endif
}

def move_chunk {
    if v_ck == 0 then
        move_sprite(earth0, 6, 6, 0, v_lc)
    elseif v_ck == 1 then
        move_sprite(earth1, 6, 6, 0, v_lc)
    elseif v_ck == 2 then
        move_sprite(earth2, 6, 6, 0, v_lc)
    elseif v_ck == 3 then
        move_sprite(earth3, 6, 6, 0, v_lc)
    elseif v_ck == 4 then
        move_sprite(earth4, 6, 6, 0, v_lc)
    elseif v_ck == 5 then
        move_sprite(earth5, 6, 6, 0, v_lc)
    elseif v_ck == 6 then
        move_sprite(earth6, 6, 6, 0, v_lc)
    else
        move_sprite(earth7, 6, 6, 0, v_lc)
    endif
}

# ---------------- space background (drawn once) ----------------
clear()
for v_i in (0, 79, 1)
    v_sx = random(0, 63, 0)
    v_sy = random(0, 63, 0)
    v_sb = random(12, 65, 0)
    v_sc = random(0, 3, 0)
    if v_sc == 0 then
        plot(v_sx, v_sy, sky_blue, v_sb)
    elseif v_sc == 1 then
        plot(v_sx, v_sy, lavender, v_sb)
    else
        plot(v_sx, v_sy, white, v_sb)
    endif
endfor v_i

# ---------------- animation ----------------
v_cf = 0
v_last = 0
v_cur = 0
v_ck = 0
v_lc = 0
call show_chunk

while true then
    v_cf = v_cf + v_rate
    if v_cf >= 72 then
        v_cf = v_cf - 72
    endif
    v_cel = int(v_cf)
    if v_cel != v_last then
        v_ck = floor(v_cel / 9)
        v_lc = v_cel - v_ck * 9
        begin_frame(true)
            if v_ck != v_cur then
                call hide_chunk
                call show_chunk
                v_cur = v_ck
            else
                call move_chunk
            endif
        end_frame
        v_last = v_cel
    endif
    rest(0.03)
endwhile
