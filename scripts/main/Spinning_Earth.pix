v_run[116] = 292829
v_run[117] = 302425

# Stamp the runs into the map as land flags (1)
for v_k in (0, 117, 1)
    v_e = v_run[v_k]
    v_r = floor(v_e / 10000)
    v_rem = v_e - v_r * 10000
    v_a = floor(v_rem / 100)
    v_b = v_rem - v_a * 100
    for v_c in (v_a, v_b - 1, 1)
        v_map[v_r * 72 + v_c] = 1
    endfor v_c
endfor v_k

# ---------------- biome classification ----------------
# Classes: 1 green, 2 dark forest/jungle, 3 desert, 4 ice, 5 steppe/savanna/
# tundra (olive), 6 mountains (brown). Uses v_lat / v_lon, sets v_cl.
def classify {
    if v_lat > 72 then
        v_cl = 4
    elseif v_lat > 58 and v_lon > -58 and v_lon < -18 then
        v_cl = 4
    elseif v_lat > 66 then
        v_cl = 5
    elseif v_lat > -55 and v_lat < 10 and v_lon > -80 and v_lon < -66 then
        v_cl = 6
    elseif v_lat > -13 and v_lat < 7 and v_lon > -76 and v_lon < -48 then
        v_cl = 2
    elseif v_lat > -27 and v_lat < -12 and v_lon > -60 and v_lon < -38 then
        v_cl = 5
    elseif v_lat < -38 and v_lon > -76 and v_lon < -60 then
        v_cl = 5
    elseif v_lat > 22 and v_lat < 36 and v_lon > -118 and v_lon < -100 then
        v_cl = 3
    elseif v_lat > 36 and v_lat < 56 and v_lon > -122 and v_lon < -104 then
        v_cl = 6
    elseif v_lat > 36 and v_lat < 52 and v_lon > -104 and v_lon < -94 then
        v_cl = 5
    elseif v_lat > 50 and v_lat < 67 and v_lon > -168 and v_lon < -58 then
        v_cl = 2
    elseif v_lat > 7 and v_lat < 21 and v_lon > -93 and v_lon < -76 then
        v_cl = 2
    elseif v_lat > -8 and v_lat < 5 and v_lon > 8 and v_lon < 32 then
        v_cl = 2
    elseif v_lat > 3 and v_lat < 9 and v_lon > -15 and v_lon < 12 then
        v_cl = 2
    elseif v_lat > 14 and v_lat < 33 and v_lon > -18 and v_lon < 62 then
        v_cl = 3
    elseif v_lat > 24 and v_lat < 38 and v_lon > 42 and v_lon < 68 then
        v_cl = 3
    elseif v_lat > 24 and v_lat < 32 and v_lon > 60 and v_lon < 75 then
        v_cl = 3
    elseif v_lat > 26 and v_lat < 38 and v_lon > 74 and v_lon < 104 then
        v_cl = 6
    elseif v_lat > 36 and v_lat < 48 and v_lon > 78 and v_lon < 114 then
        v_cl = 3
    elseif v_lat > 40 and v_lat < 54 and v_lon > 44 and v_lon < 82 then
        v_cl = 5
    elseif v_lat > 4 and v_lat < 14 and v_lon > -18 and v_lon < 48 then
        v_cl = 5
    elseif v_lat > -10 and v_lat < 6 and v_lon > 30 and v_lon < 48 then
        v_cl = 5
    elseif v_lat > -30 and v_lat < -17 and v_lon > 11 and v_lon < 26 then
        v_cl = 3
    elseif v_lat > -17 and v_lat < -6 and v_lon > 12 and v_lon < 42 then
        v_cl = 5
    elseif v_lat > 54 and v_lat < 67 and v_lon > 5 and v_lon < 175 then
        v_cl = 2
    elseif v_lat > -12 and v_lat < 24 and v_lon > 92 and v_lon < 150 then
        v_cl = 2
    elseif v_lat > -32 and v_lat < -19 and v_lon > 116 and v_lon < 142 then
        v_cl = 3
    elseif v_lat > -19 and v_lat < -10 and v_lon > 120 and v_lon < 146 then
        v_cl = 5
    else
        v_cl = 1
    endif
}

v_status = "Biomes"
v_detail = "land+clouds"
v_pct = 3
call show_loading

# Walk every map cell: classify land, force polar ice caps, add clouds.
# Cell codes: 0 ocean, 1-6 land class, +10 = thin cloud over it, 99 = thick cloud.
for v_r in (0, 35, 1)
    v_t = fmod(v_r, 12)
    if v_t == 0 then
        v_pct = 3 + v_r * 5 / 36
        call show_loading
    endif
    v_lat = 87.5 - v_r * 5
    v_b = radians(v_lat)
    for v_c in (0, 71, 1)
        v_idx = v_r * 72 + v_c
        v_lon = v_c * 5 - 177.5
        v_cl = 0
        if v_map[v_idx] == 1 then
            call classify
        endif
        if v_lat > 80 or v_lat < -65 then
            v_cl = 4
        endif
        if v_cl != 4 then
            v_a = v_c * 0.0872665
            v_n = sin(3 * v_a + 2 * sin(2 * v_b)) + sin(7 * v_a - 3 * v_b + 1.3) + sin(11 * v_a + 5 * v_b + 0.7) + 0.8 * sin(2 * v_a + 9 * v_b + 2.0)
            v_z = cos(6 * v_b)
            v_s2 = 0.55 * v_n + 1.1 * v_z
            if v_s2 > v_thk then
                v_cl = 99
            elseif v_s2 > v_thn then
                v_cl = v_cl + 10
            endif
        endif
        v_map[v_idx] = v_cl
    endfor v_c
endfor v_r

# ---------------- precompute sphere pixels ----------------
v_status = "Sphere"
v_detail = "pixel map"
v_pct = 8
call show_loading

v_np = 0
v_nh = 0
for v_py in (0, 51, 1)
    v_t = fmod(v_py, 13)
    if v_t == 0 then
        v_pct = 8 + v_py * 5 / 52
        call show_loading
    endif
    for v_px in (0, 51, 1)
        v_nx = (v_px + 0.5 - v_cx) / v_radius
        v_ny = (v_py + 0.5 - v_cy) / v_radius
        v_d2 = v_nx * v_nx + v_ny * v_ny
        if v_d2 <= 1 then
            v_nz = sqrt(1 - v_d2)
            v_x1 = v_nx * v_ct + v_ny * v_st
            v_sl = v_nx * v_st - v_ny * v_ct
            v_sl = max(-1, min(1, v_sl))
            v_lat = degrees(asin(v_sl))
            v_row = floor((90 - v_lat) / 5)
            v_row = max(0, min(35, v_row))
            v_lon = degrees(atan2(v_x1, v_nz))
            v_gx[v_np] = v_px
            v_gy[v_np] = v_py
            v_rw[v_np] = v_row * 72
            v_c0[v_np] = (v_lon + 180) / 5
            v_dl = max(v_nx * v_lgx + v_ny * v_lgy + v_nz * v_lgz, 0)
            v_sh[v_np] = int(6 + 94 * sqrt(v_dl))
            v_np = v_np + 1
        elseif v_d2 <= 1.1378 then
            v_dd = sqrt(v_d2)
            v_ux = v_nx / v_dd
            v_uy = v_ny / v_dd
            v_lit = max(v_ux * v_lgx + v_uy * v_lgy, 0)
            v_dist = (v_dd - 1) / 0.0667
            v_hx_p[v_nh] = v_px
            v_hy_p[v_nh] = v_py
            v_hi[v_nh] = int((10 + 60 * v_lit) * (1 - 0.55 * v_dist))
            v_nh = v_nh + 1
        endif
    endfor v_px
endfor v_py

# ---------------- city lights (lat, lon) ----------------
v_ncity = 38
create_array(v_clat, 38)
create_array(v_clon, 38)
v_clat[0] = 40.7
v_clon[0] = -74.0
v_clat[1] = 41.9
v_clon[1] = -87.6
