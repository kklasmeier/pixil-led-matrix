v_clon[37] = -80.2

# ---------------- renderers ----------------
# Plot a surface class at (v_xx, v_yy) with shade v_s (used for thin clouds)
def plot_class {
    if v_kk == 0 then
        plot(v_xx, v_yy, royal_blue, v_s)
    elseif v_kk == 1 then
        plot(v_xx, v_yy, green, v_s)
    elseif v_kk == 2 then
        plot(v_xx, v_yy, forest_green, v_s)
    elseif v_kk == 3 then
        plot(v_xx, v_yy, tan, v_s)
    elseif v_kk == 4 then
        plot(v_xx, v_yy, white, v_s)
    elseif v_kk == 5 then
        plot(v_xx, v_yy, olive, v_s)
    else
        plot(v_xx, v_yy, brown, v_s)
    endif
}

# Render one rotation frame; v_shift = rotation in map columns (5 degrees each)
def draw_earth {
    # Surface: ocean, land biomes and clouds
    for v_i in (0, v_np - 1, 1)
        v_m = v_rw[v_i] + floor(fmod(v_c0[v_i] + 72 - v_shift, 72))
        v_k = v_map[v_m]
        v_s = v_sh[v_i]
        if v_k == 0 then
            plot(v_gx[v_i], v_gy[v_i], royal_blue, v_s)
        elseif v_k == 1 then
            plot(v_gx[v_i], v_gy[v_i], green, v_s)
        elseif v_k == 2 then
            plot(v_gx[v_i], v_gy[v_i], forest_green, v_s)
        elseif v_k == 3 then
            plot(v_gx[v_i], v_gy[v_i], tan, v_s)
        elseif v_k == 4 then
            plot(v_gx[v_i], v_gy[v_i], white, v_s)
        elseif v_k == 5 then
            plot(v_gx[v_i], v_gy[v_i], olive, v_s)
        elseif v_k == 6 then
            plot(v_gx[v_i], v_gy[v_i], brown, v_s)
        elseif v_k == 99 then
            plot(v_gx[v_i], v_gy[v_i], white, v_s)
        else
            v_xx = v_gx[v_i]
            v_yy = v_gy[v_i]
            v_pr = fmod(v_xx + v_yy, 2)
            if v_pr == 0 then
                plot(v_xx, v_yy, white, v_s)
            else
                v_kk = v_k - 10
                call plot_class
            endif
        endif
    endfor v_i

    # Atmosphere halo
    for v_j in (0, v_nh - 1, 1)
        v_t = v_hi[v_j]
        plot(v_hx_p[v_j], v_hy_p[v_j], sky_blue, v_t)
    endfor v_j

    # City lights on the night side
    for v_j in (0, v_ncity - 1, 1)
        v_la = radians(v_clat[v_j])
        v_lo = radians(v_clon[v_j] + v_shift * 5)
        v_ex = cos(v_la) * sin(v_lo)
        v_ey = sin(v_la)
        v_ez = cos(v_la) * cos(v_lo)
        if v_ez > 0.1 then
            v_vx = v_ex * v_ct + v_ey * v_st
            v_vy = v_ex * v_st - v_ey * v_ct
            v_dd = v_vx * v_lgx + v_vy * v_lgy + v_ez * v_lgz
            if v_dd < -0.05 then
                plot(round(v_cx + v_vx * v_radius), round(v_cy + v_vy * v_radius), yellow, 90)
            endif
        endif
    endfor v_j
}

# ---------------- sprites: 8 chunks x 9 cels, 5 degrees per cel ----------------
# Chunk n holds cels 9n .. 9n+8. v_shift is the global cel number.

v_status = "Rendering"
v_detail = "cels 1-9"
v_pct = 13
call show_loading

define_sprite(earth0, 52, 52)
    sprite_cel(0)
        v_shift = 0 * v_spin_sign
        call draw_earth
    sprite_cel(1)
        v_shift = 1 * v_spin_sign
        call draw_earth
    sprite_cel(2)
        v_shift = 2 * v_spin_sign
        call draw_earth
    sprite_cel(3)
        v_shift = 3 * v_spin_sign
        call draw_earth
    sprite_cel(4)
        v_shift = 4 * v_spin_sign
        call draw_earth
    sprite_cel(5)
        v_shift = 5 * v_spin_sign
        call draw_earth
    sprite_cel(6)
        v_shift = 6 * v_spin_sign
        call draw_earth
    sprite_cel(7)
        v_shift = 7 * v_spin_sign
        call draw_earth
    sprite_cel(8)
        v_shift = 8 * v_spin_sign
        call draw_earth
endsprite

