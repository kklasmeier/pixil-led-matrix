# ==============================================================================
# SPINNING EARTH  (64x64 matrix)
#
# A realistic Earth rendered once into 72 sprite cels (5 degrees per cel),
# then played back as a slow, seamless rotation (west to east, 23.4 deg tilt).
#
# The cels are split across 8 sprites (earth0..earth7, 9 cels each) so a
# loading screen can show real progress between chunks. Playback swaps between
# the chunks invisibly.
#
# Surface data: a 72x36 land map (5 degree cells) built from continent outlines,
# coloured by biome (rainforest, boreal forest, desert, steppe, mountains, ice).
# Extras: cloud bands, day/night terminator, city lights on the dark side and
# a thin atmosphere halo.
# ==============================================================================

clear()
fps(45)

# ---------------- tunable settings ----------------
v_radius = 24            # planet radius in pixels (sprite is 52x52)
v_cx = 26                # planet centre inside the sprite
v_cy = 26
v_tilt = radians(23.4)   # axial tilt (north pole leans up-right)
v_spin_sign = 1          # change to -1 to spin the other way
v_rate = 0.2             # cels per loop pass: 0.2 = one rotation in about 12 s
v_thn = 1.25             # cloud threshold, thin clouds (lower = cloudier)
v_thk = 2.4              # cloud threshold, thick clouds
v_fs = 6                 # loading-screen font size (lower if text is too wide)

v_ct = cos(v_tilt)
v_st = sin(v_tilt)

# Sun direction (from the upper left, slightly toward the viewer)
v_lgx = -0.72
v_lgy = -0.30
v_lgz = 0.62

# ---------------- loading screen ----------------
# Uses globals v_status, v_detail (short text) and v_pct (0-100)
def show_loading {
    v_pctn = int(v_pct)
    v_bw = int(46 * v_pct / 100)
    begin_frame
        draw_text(32, 4, "EARTH", tiny64_font, v_fs + 2, sky_blue, 100, NORMAL, CENTER)
        draw_text(32, 20, v_status, tiny64_font, v_fs, white, 100, NORMAL, CENTER)
        draw_text(32, 29, v_detail, tiny64_font, v_fs, gray, 80, NORMAL, CENTER)
        draw_text(30, 40, v_pctn, tiny64_font, v_fs, yellow, 100, NORMAL, RIGHT)
        draw_text(31, 40, "%", tiny64_font, v_fs, yellow, 100)
        draw_rectangle(8, 52, 48, 6, gray, 60, false)
        if v_bw > 0 then
            draw_rectangle(9, 53, v_bw, 4, lime, 100, true)
        endif
    end_frame
}

v_status = "Starting"
v_detail = "please wait"
v_pct = 0
call show_loading

# ---------------- arrays ----------------
create_array(v_map, 2592)       # 72 x 36 cells, index = row * 72 + col
grid_fill(v_map, 0)

# Disc pixels (precomputed once)
create_array(v_gx, 1900)
create_array(v_gy, 1900)
create_array(v_rw, 1900)
create_array(v_c0, 1900)
create_array(v_sh, 1900)
# Halo pixels
create_array(v_hx_p, 320)
create_array(v_hy_p, 320)
create_array(v_hi, 320)

# ---------------- land runs ----------------
v_status = "Land map"
v_detail = "coastlines"
v_pct = 1
call show_loading

# Each entry = row * 10000 + start_col * 100 + end_col (end exclusive).
# Row 0 is the north pole band; each row is 5 degrees of latitude, each column
# is 5 degrees of longitude starting at 180W.
create_array(v_run, 118)
v_run[0] = 11931
v_run[1] = 21431
v_run[2] = 23842
v_run[3] = 24650
v_run[4] = 30308
