        v_shift = 16 * v_spin_sign
        call draw_earth
    sprite_cel(8)
        v_shift = 17 * v_spin_sign
        call draw_earth
endsprite

v_detail = "cels 19-27"
v_pct = 34.8
call show_loading

define_sprite(earth2, 52, 52)
    sprite_cel(0)
        v_shift = 18 * v_spin_sign
        call draw_earth
    sprite_cel(1)
        v_shift = 19 * v_spin_sign
        call draw_earth
    sprite_cel(2)
        v_shift = 20 * v_spin_sign
        call draw_earth
    sprite_cel(3)
        v_shift = 21 * v_spin_sign
        call draw_earth
    sprite_cel(4)
