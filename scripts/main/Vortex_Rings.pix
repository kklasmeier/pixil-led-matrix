# Vortex Rings
# Periodic smoke rings expand and fade. Each ring owns crest attractors
# with its own swirl sign so rings pass through each other.

throttle(0)
fps(60)

v_n = 20
v_rings = 3
v_crests = 4
v_time = 0
v_spawn_timer = 0
v_spawn_every = 55
v_frame_scale = 0.9
v_max_r = 30

create_array(v_x, v_n, numeric)
create_array(v_y, v_n, numeric)
create_array(v_vx, v_n, numeric)
create_array(v_vy, v_n, numeric)
create_array(v_ax, v_n, numeric)
create_array(v_ay, v_n, numeric)
create_array(v_active, v_n, numeric)
create_array(v_wall_hit, v_n, numeric)

create_array(v_rx, v_rings, numeric)
create_array(v_ry, v_rings, numeric)
create_array(v_rr, v_rings, numeric)
create_array(v_ralive, v_rings, numeric)
create_array(v_rdir, v_rings, numeric)
create_array(v_rgrow, v_rings, numeric)

create_array(v_crest_x, v_crests, numeric)
create_array(v_crest_y, v_crests, numeric)

def init_smoke {
    for v_i in (0, v_n - 1, 1)
        v_x[v_i] = random(8, 56, 0)
        v_y[v_i] = random(8, 56, 0)
        v_vx[v_i] = random(-0.3, 0.3, 2)
        v_vy[v_i] = random(-0.3, 0.3, 2)
        v_ax[v_i] = 0
        v_ay[v_i] = 0
        v_active[v_i] = 1
    endfor v_i
    for v_i in (0, v_rings - 1, 1)
        v_ralive[v_i] = 0
        v_rr[v_i] = 0
    endfor v_i
}

def spawn_ring {
    v_slot = -1
    for v_i in (0, v_rings - 1, 1)
        if v_ralive[v_i] == 0 and v_slot < 0 then
            v_slot = v_i
        endif
    endfor v_i
    if v_slot >= 0 then
        v_rx[v_slot] = random(16, 48, 0)
        v_ry[v_slot] = random(16, 48, 0)
        v_rr[v_slot] = 3
        v_rgrow[v_slot] = random(0.28, 0.42, 2)
        if random(0, 1, 0) == 0 then
            v_rdir[v_slot] = 1
        else
            v_rdir[v_slot] = -1
        endif
        v_ralive[v_slot] = 1
    endif
}

def apply_ring {
    # Uses v_r as the ring index. Swirl is scalar per call (engine limit).
    v_life = 1 - (v_rr[v_r] - 3) / (v_max_r - 3)
    if v_life < 0 then
        v_life = 0
    endif
    v_pull = 0.072 * v_life
    v_spin = v_rdir[v_r] * (1.275 + 1.35 * v_life)
    v_phase = v_time * 0.9 * v_rdir[v_r] + v_r * 1.1
    v_step = 6.2832 / v_crests
    for v_c in (0, v_crests - 1, 1)
        v_a = v_phase + v_c * v_step
        v_crest_x[v_c] = v_rx[v_r] + cos(v_a) * v_rr[v_r]
        v_crest_y[v_c] = v_ry[v_r] + sin(v_a) * v_rr[v_r]
    endfor v_c
    particle_apply_attractors(v_x, v_y, v_ax, v_ay, v_active, v_crest_x, v_crest_y, v_pull, 1, 1, 2.0, 7, v_n, v_crests, v_spin)
}

call init_smoke
call spawn_ring

while true then
    v_spawn_timer = v_spawn_timer + 1
    if v_spawn_timer >= v_spawn_every then
        call spawn_ring
        v_spawn_timer = 0
        v_spawn_every = random(40, 70, 0)
    endif

    for v_r in (0, v_rings - 1, 1)
        if v_ralive[v_r] == 1 then
            v_rr[v_r] = v_rr[v_r] + v_rgrow[v_r]
            if v_rr[v_r] >= v_max_r then
                v_ralive[v_r] = 0
            endif
        endif
    endfor v_r

    for v_i in (0, v_n - 1, 1)
        v_ax[v_i] = 0
        v_ay[v_i] = 0
    endfor v_i

    for v_r in (0, v_rings - 1, 1)
        if v_ralive[v_r] == 1 then
            call apply_ring
        endif
    endfor v_r

    particle_integrate(v_x, v_y, v_vx, v_vy, v_active, v_ax, v_ay, 0.985, 0, v_n, post_move, 2.4, v_frame_scale)
    particle_collide_bounds(v_x, v_y, v_vx, v_vy, v_active, 0, 63, 0, 63, 0.7, 0, v_wall_hit, v_n)

    v_mood = sin(v_time * 0.12) + 1
    v_dust_bright = 40 + v_mood * 18

    begin_frame
        draw_rectangle(0, 0, 64, 64, navy, 16, true)
        for v_r in (0, v_rings - 1, 1)
            if v_ralive[v_r] == 1 then
                v_life = 1 - (v_rr[v_r] - 3) / (v_max_r - 3)
                if v_life < 0 then
                    v_life = 0
                endif
                v_ring_bright = 20 + v_life * 55
                if v_rdir[v_r] > 0 then
                    draw_circle(v_rx[v_r], v_ry[v_r], v_rr[v_r], cyan, v_ring_bright, false)
                else
                    draw_circle(v_rx[v_r], v_ry[v_r], v_rr[v_r], magenta, v_ring_bright, false)
                endif
            endif
        endfor v_r
        for v_i in (0, 9, 1)
            mplot(v_x[v_i], v_y[v_i], cyan, v_dust_bright)
        endfor v_i
        for v_i in (10, v_n - 1, 1)
            mplot(v_x[v_i], v_y[v_i], white, v_dust_bright)
        endfor v_i
        mflush
    end_frame

    v_time = v_time + 0.035
endwhile
