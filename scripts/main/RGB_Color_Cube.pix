# RGB Color Cube v2 — same look as RGB_Color_Cube.pix
# Producer-side: bake painter-order draw lists so the live loop only issues draws.

throttle(0)
fps(60)

v_center_x = 32
v_center_y = 32
v_size = 20
v_total_frames = 360

create_array(v_vertices_x, 8)
create_array(v_vertices_y, 8)
create_array(v_vertices_z, 8)
create_array(v_colors, 8, string)

v_vertices_x[0] = -1
v_vertices_y[0] = -1
v_vertices_z[0] = -1
v_colors[0] = "gray"

v_vertices_x[1] = 1
v_vertices_y[1] = -1
v_vertices_z[1] = -1
v_colors[1] = "red"

v_vertices_x[2] = -1
v_vertices_y[2] = 1
v_vertices_z[2] = -1
v_colors[2] = "green"

v_vertices_x[3] = 1
v_vertices_y[3] = 1
v_vertices_z[3] = -1
v_colors[3] = "yellow"

v_vertices_x[4] = -1
v_vertices_y[4] = -1
v_vertices_z[4] = 1
v_colors[4] = "blue"

v_vertices_x[5] = 1
v_vertices_y[5] = -1
v_vertices_z[5] = 1
v_colors[5] = "magenta"

v_vertices_x[6] = -1
v_vertices_y[6] = 1
v_vertices_z[6] = 1
v_colors[6] = "cyan"

v_vertices_x[7] = 1
v_vertices_y[7] = 1
v_vertices_z[7] = 1
v_colors[7] = "white"

create_array(v_edge_start, 12)
create_array(v_edge_end, 12)
create_array(v_edge_colors, 12, string)

v_edge_start[0] = 0
v_edge_end[0] = 1
v_edge_colors[0] = "red"

v_edge_start[1] = 1
v_edge_end[1] = 3
v_edge_colors[1] = "yellow"

v_edge_start[2] = 3
v_edge_end[2] = 2
v_edge_colors[2] = "green"

v_edge_start[3] = 2
v_edge_end[3] = 0
v_edge_colors[3] = "gray"

v_edge_start[4] = 4
v_edge_end[4] = 5
v_edge_colors[4] = "magenta"

v_edge_start[5] = 5
v_edge_end[5] = 7
v_edge_colors[5] = "white"

v_edge_start[6] = 7
v_edge_end[6] = 6
v_edge_colors[6] = "cyan"

v_edge_start[7] = 6
v_edge_end[7] = 4
v_edge_colors[7] = "blue"

v_edge_start[8] = 0
v_edge_end[8] = 4
v_edge_colors[8] = "blue"

v_edge_start[9] = 1
v_edge_end[9] = 5
v_edge_colors[9] = "magenta"

v_edge_start[10] = 2
v_edge_end[10] = 6
v_edge_colors[10] = "cyan"

v_edge_start[11] = 3
v_edge_end[11] = 7
v_edge_colors[11] = "white"

# Static corner dots live on a background so the live loop does not plot them
define_sprite(cube_dots, 64, 64)
    plot(0, 0, red, 30)
    plot(0, 21, magenta, 30)
    plot(0, 42, magenta, 30)
    plot(0, 63, magenta, 30)
    plot(21, 0, red, 30)
    plot(21, 21, red, 30)
    plot(21, 42, magenta, 30)
    plot(21, 63, magenta, 30)
    plot(42, 0, green, 30)
    plot(42, 21, green, 30)
    plot(42, 42, yellow, 30)
    plot(42, 63, yellow, 30)
    plot(63, 0, green, 30)
    plot(63, 21, green, 30)
    plot(63, 42, yellow, 30)
    plot(63, 63, yellow, 30)
endsprite

set_background(cube_dots, 0, 0)

# Per-frame scratch for the 8 projected vertices
create_array(v_px, 8)
create_array(v_py, 8)
create_array(v_pz, 8)

# Flattened painter-order draw lists (back then front, same as original)
create_array(v_e_off, v_total_frames)
create_array(v_e_count, v_total_frames)
create_array(v_ex1, 4320)
create_array(v_ey1, 4320)
create_array(v_ex2, 4320)
create_array(v_ey2, 4320)
create_array(v_eint, 4320)
create_array(v_ecol, 4320, string)

create_array(v_v_off, v_total_frames)
create_array(v_v_count, v_total_frames)
create_array(v_vx, 2880)
create_array(v_vy, 2880)
create_array(v_vint, 2880)
create_array(v_vcol, 2880, string)

print("Pre-calculating animation frames...")

v_rot_speed_x = 2 * pi / 180
v_rot_speed_y = 2 * pi / 120
v_rot_speed_z = 2 * pi / 90

v_e_used = 0
v_v_used = 0
v_frame = 0
while v_frame < v_total_frames then
    v_rot_x = v_frame * v_rot_speed_x
    v_rot_y = v_frame * v_rot_speed_y
    v_rot_z = v_frame * v_rot_speed_z

    v_cos_x = cos(v_rot_x)
    v_sin_x = sin(v_rot_x)
    v_cos_y = cos(v_rot_y)
    v_sin_y = sin(v_rot_y)
    v_cos_z = cos(v_rot_z)
    v_sin_z = sin(v_rot_z)

    v_i = 0
    while v_i < 8 then
        v_x = v_vertices_x[v_i]
        v_y = v_vertices_y[v_i]
        v_z = v_vertices_z[v_i]

        v_y2 = v_y * v_cos_x - v_z * v_sin_x
        v_z2 = v_y * v_sin_x + v_z * v_cos_x

        v_x2 = v_x * v_cos_y + v_z2 * v_sin_y
        v_z3 = -v_x * v_sin_y + v_z2 * v_cos_y

        v_x3 = v_x2 * v_cos_z - v_y2 * v_sin_z
        v_y3 = v_x2 * v_sin_z + v_y2 * v_cos_z

        v_scale = 1.5 / (4 + v_z3)
        v_px[v_i] = v_x3 * v_scale * v_size + v_center_x
        v_py[v_i] = v_y3 * v_scale * v_size + v_center_y
        v_pz[v_i] = v_z3

        v_i = v_i + 1
    endwhile

    v_e_off[v_frame] = v_e_used
    v_pass = 0
    while v_pass < 2 then
        v_i = 0
        while v_i < 12 then
            v_s = v_edge_start[v_i]
            v_e = v_edge_end[v_i]
            v_avg_depth = (v_pz[v_s] + v_pz[v_e]) / 2
            v_keep = 0
            if v_pass == 0 and v_avg_depth < 0 then
                v_keep = 1
            endif
            if v_pass == 1 and v_avg_depth >= 0 then
                v_keep = 1
            endif
            if v_keep == 1 then
                v_intensity = 40 + ((v_avg_depth + 1) / 2) * 60
                if v_pass == 1 and v_intensity > 100 then
                    v_intensity = 100
                endif
                v_ex1[v_e_used] = v_px[v_s]
                v_ey1[v_e_used] = v_py[v_s]
                v_ex2[v_e_used] = v_px[v_e]
                v_ey2[v_e_used] = v_py[v_e]
                v_eint[v_e_used] = v_intensity
                v_ecol[v_e_used] = v_edge_colors[v_i]
                v_e_used = v_e_used + 1
            endif
            v_i = v_i + 1
        endwhile
        v_pass = v_pass + 1
    endwhile
    v_e_count[v_frame] = v_e_used - v_e_off[v_frame]

    v_v_off[v_frame] = v_v_used
    v_pass = 0
    while v_pass < 2 then
        v_i = 0
        while v_i < 8 then
            v_depth = v_pz[v_i]
            v_keep = 0
            if v_pass == 0 and v_depth < 0 then
                v_keep = 1
            endif
            if v_pass == 1 and v_depth >= 0 then
                v_keep = 1
            endif
            if v_keep == 1 then
                v_intensity = 40 + ((v_depth + 1) / 2) * 60
                if v_pass == 1 and v_intensity > 100 then
                    v_intensity = 100
                endif
                v_vx[v_v_used] = v_px[v_i]
                v_vy[v_v_used] = v_py[v_i]
                v_vint[v_v_used] = v_intensity
                v_vcol[v_v_used] = v_colors[v_i]
                v_v_used = v_v_used + 1
            endif
            v_i = v_i + 1
        endwhile
        v_pass = v_pass + 1
    endwhile
    v_v_count[v_frame] = v_v_used - v_v_off[v_frame]

    if v_frame % 45 == 0 then
        print(f"Pre-calculating... {v_frame / 3.6}% complete")
        begin_frame
        end_frame
    endif

    v_frame = v_frame + 1
endwhile

print("Calculation complete. Starting animation...")

v_current_frame = 0
while 1 == 1 then
    begin_frame

    v_e = v_e_off[v_current_frame]
    v_n = v_e_count[v_current_frame]
    v_i = 0
    while v_i < v_n then
        draw_line(v_ex1[v_e], v_ey1[v_e], v_ex2[v_e], v_ey2[v_e], v_ecol[v_e], v_eint[v_e])
        v_e = v_e + 1
        v_i = v_i + 1
    endwhile

    v_v = v_v_off[v_current_frame]
    v_n = v_v_count[v_current_frame]
    v_i = 0
    while v_i < v_n then
        draw_circle(v_vx[v_v], v_vy[v_v], 2, v_vcol[v_v], v_vint[v_v], true)
        v_v = v_v + 1
        v_i = v_i + 1
    endwhile

    v_current_frame = v_current_frame + 1
    if v_current_frame >= v_total_frames then
        v_current_frame = 0
    endif

    end_frame
endwhile
