# Swarm v2
# The show still chooses chaos/order modes and attractor paths. Reusable
# particle primitives apply the pull, move the swarm, cap speed, and bounce.

throttle(0)
fps(60)

v_density = 20
v_time = 0
v_cycle_duration = 15
v_mode = 0
v_pattern = 0
v_attract_x = 32
v_attract_y = 32
v_frame_scale = 0.5

create_array(v_x, v_density, numeric)
create_array(v_y, v_density, numeric)
create_array(v_vx, v_density, numeric)
create_array(v_vy, v_density, numeric)
create_array(v_ax, v_density, numeric)
create_array(v_ay, v_density, numeric)
create_array(v_active, v_density, numeric)
create_array(v_wall_hit, v_density, numeric)
create_array(v_attractor_x, 1, numeric)
create_array(v_attractor_y, 1, numeric)

def init_swarm {
    for v_i in (0, v_density - 1, 1)
        v_x[v_i] = random(0, 63, 0)
        v_y[v_i] = random(0, 63, 0)
        v_vx[v_i] = random(-1, 1, 1)
        v_vy[v_i] = random(-1, 1, 1)
        v_ax[v_i] = 0
        v_ay[v_i] = 0
        v_active[v_i] = 1
    endfor v_i
}

def choose_mode_and_target {
    v_cycle = v_time % v_cycle_duration
    v_new_mode = 0
    if v_cycle >= 7.5 then
        v_new_mode = 1
    endif

    if v_new_mode != v_mode and v_new_mode == 1 then
        v_pattern = random(0, 3, 0)
    endif
    v_mode = v_new_mode

    if v_mode == 1 then
        if v_pattern == 0 then
            v_attract_x = 32 + 16 * cos(v_time * 0.4)
            v_attract_y = 32 + 16 * sin(v_time * 0.4)
        elseif v_pattern == 1 then
            v_phase = v_time % 4
            if v_phase < 1 then
                v_attract_x = 48
                v_attract_y = 48
            elseif v_phase < 2 then
                v_attract_x = 48
                v_attract_y = 16
            elseif v_phase < 3 then
                v_attract_x = 16
                v_attract_y = 16
            else
                v_attract_x = 16
                v_attract_y = 48
            endif
        elseif v_pattern == 2 then
            v_attract_x = 32 + 16 * sin(v_time * 0.4)
            v_attract_y = 32 + 8 * sin(v_time * 0.8)
        else
            v_step = v_time % 0.5
            if v_step < 0.025 then
                v_attract_x = random(16, 48, 0)
                v_attract_y = random(16, 48, 0)
            endif
        endif
        v_attractor_x[0] = v_attract_x
        v_attractor_y[0] = v_attract_y
    endif
}

def prepare_acceleration {
    for v_i in (0, v_density - 1, 1)
        if v_mode == 0 then
            v_ax[v_i] = random(-0.1, 0.1, 2)
            v_ay[v_i] = random(-0.1, 0.1, 2)
        else
            v_ax[v_i] = random(-0.15, 0.15, 2)
            v_ay[v_i] = random(-0.15, 0.15, 2)
        endif
    endfor v_i
}

call init_swarm

while true then
    call choose_mode_and_target
    call prepare_acceleration

    # falloff=-1 reproduces the original spring-like dx * strength pull.
    if v_mode == 1 then
        particle_apply_attractors(v_x, v_y, v_ax, v_ay, v_active, v_attractor_x, v_attractor_y, 0.025, 1, -1, 0, 10, v_density, 1)
    endif

    v_mood = sin(v_time * 0.1) + 1
    v_speed_scale = 0.5 + v_mood * 1.5
    v_move_scale = v_speed_scale * v_frame_scale
    v_bright = 30 + v_mood * 25

    particle_integrate(v_x, v_y, v_vx, v_vy, v_active, v_ax, v_ay, 1, 0, v_density, post_move, 2, v_move_scale)
    particle_collide_bounds(v_x, v_y, v_vx, v_vy, v_active, 0, 63, 0, 63, 1, 0, v_wall_hit, v_density)

    begin_frame
        draw_rectangle(0, 0, 64, 64, navy, 20, true)
        for v_i in (0, v_density - 1, 1)
            plot(v_x[v_i], v_y[v_i], white, v_bright)
        endfor v_i
    end_frame

    v_time = v_time + 0.025
endwhile
