# ============================================================
# HYPERSPACE TRANSITION (v6 - draw_lines batch)
# ============================================================
# Hyper streaks fill endpoint arrays then flush with draw_lines
# (two batches: azure body + cyan tip). Chase lanes keep rays on
# recycle; chaos stars still randomize. Soft step caps motion jumps.
# ============================================================

throttle(0)
fps(60)

v_num_stars = 64
v_hyper_stars = 56
v_chase = 28
v_cx = 32
v_cy = 32

v_z_far = 32
v_focal = 32

v_speed_cruise = 0.20
v_speed_hyper = 2.6
v_streak_z = 7.0
v_void_r = 6

v_cruise_ms = 9000
v_ramp_up_ms = 4000
v_hold_ms = 2500
v_ramp_down_ms = 4000
v_t1c = v_cruise_ms + v_ramp_up_ms
v_t2c = v_t1c + v_hold_ms
v_cycle_len = v_t2c + v_ramp_down_ms

v_cycle_t = 0
v_phase = 0
v_prev_phase = 0
v_ramp_t = 0.0
v_hyper = 0.0
v_star_speed = 0.12
v_neg_move = 0.0
v_dz = 0.0
v_void_eff = 0.0
v_vlim = 0.5
v_h15 = 0
v_flash = 0.0
v_now = 0
v_last = 0
v_ms = 0
v_dt = 1.0
v_step = 1.0

v_frames = 0
v_fps_t0 = 0
v_fps = 0
v_p1 = 0
v_p2 = 0
v_p3 = 0
v_s1 = 0
v_s2 = 0
v_s3 = 0
v_a1 = 0
v_a2 = 0
v_a3 = 0

v_i = 0
v_ang = 0.0
v_ca = 0.0
v_sa = 0.0
v_big = 0.0
v_b2 = 0.0
v_rnd = 0.0
v_u = 0.0
v_w = 0.0
v_rt = 0.0
v_rh = 0.0
v_mr = 0.0
v_b = 0
v_nseg = 0

create_array(v_ux, v_num_stars)
create_array(v_uy, v_num_stars)
create_array(v_lf, v_num_stars)
create_array(v_edge, v_num_stars)
create_array(v_sz, v_num_stars)
create_array(v_vz, v_num_stars)
create_array(v_pdy, v_num_stars)
create_array(v_pdvy, v_num_stars)
create_array(v_active, v_num_stars)

# Streak segment endpoints (filled each hyper frame, compacted)
create_array(v_x0, v_num_stars)
create_array(v_y0, v_num_stars)
create_array(v_xm, v_num_stars)
create_array(v_ym, v_num_stars)
create_array(v_x1, v_num_stars)
create_array(v_y1, v_num_stars)
create_array(v_bi, v_num_stars)
create_array(v_bi2, v_num_stars)

def spawn_star {
    v_ang = random(0, 6.283, 3)
    v_ca = cos(v_ang)
    v_sa = sin(v_ang)
    v_ux[v_i] = v_ca
    v_uy[v_i] = v_sa
    v_big = abs(v_ca)
    v_b2 = abs(v_sa)
    if v_b2 > v_big then
        v_big = v_b2
    endif
    v_edge[v_i] = 31 / v_big
    v_rnd = random(0, 1, 3)
    v_lf[v_i] = (4 + 12 * sqrt(v_rnd)) * v_focal
    v_sz[v_i] = v_z_far - random(0, 4, 1)
}

def respawn_chase {
    v_rnd = random(0, 1, 3)
    v_lf[v_i] = (4 + 12 * sqrt(v_rnd)) * v_focal
    v_sz[v_i] = v_z_far - random(0, 3, 1)
}

def init_stars {
    for v_i in (0, v_num_stars - 1, 1)
        v_active[v_i] = 1
        v_vz[v_i] = 0
        v_pdy[v_i] = 0
        v_pdvy[v_i] = 0
        call spawn_star
        v_sz[v_i] = random(8, 32, 1)
    endfor v_i
}

def update_cycle {
    v_prev_phase = v_phase
    v_now = get_system("runtime")
    v_ms = v_now - v_last
    v_last = v_now
    if v_ms > 100 then
        v_ms = 100
    endif
    v_dt = v_ms / 16.667
    v_step = v_dt
    if v_step > 1.6 then
        v_step = 1.6
    endif
    if v_step < 0.85 then
        v_step = 0.85
    endif

    v_cycle_t = v_cycle_t + v_ms
    if v_cycle_t >= v_cycle_len then
        v_cycle_t = v_cycle_t - v_cycle_len
    endif

    if v_cycle_t < v_cruise_ms then
        v_phase = 0
        v_hyper = 0.0
    elseif v_cycle_t < v_t1c then
        v_phase = 1
        v_ramp_t = (v_cycle_t - v_cruise_ms) / v_ramp_up_ms
        v_hyper = v_ramp_t * v_ramp_t * v_ramp_t
    elseif v_cycle_t < v_t2c then
        v_phase = 2
        v_hyper = 1.0
    else
        v_phase = 3
        v_ramp_t = (v_cycle_t - v_t2c) / v_ramp_down_ms
        v_hyper = (1.0 - v_ramp_t) * (1.0 - v_ramp_t)
    endif

    if v_phase == 2 and v_prev_phase != 2 then
        v_flash = 1.0
    endif

    v_star_speed = v_speed_cruise + v_hyper * (v_speed_hyper - v_speed_cruise)
    v_neg_move = 0 - v_star_speed * v_step
    v_dz = v_hyper * v_streak_z
    v_void_eff = v_void_r * v_hyper * v_hyper
    v_vlim = v_void_eff + 0.5
    v_h15 = int(v_hyper * 15)
}

call init_stars
v_last = get_system("runtime")
v_fps_t0 = v_last


while true then
    begin_frame
        call update_cycle

        particle_integrate(v_sz, v_pdy, v_vz, v_pdvy, v_active, v_neg_move, 0, 0, 0, v_num_stars)

        if v_flash > 0.03 then
            draw_circle(32, 32, 3 + int((1.0 - v_flash) * 28), white, int(v_flash * 85), false)
            v_flash = v_flash - 0.035 * v_step
        endif
        v_p1 = get_system("runtime")

        if v_hyper < 0.08 then
            for v_i in (0, v_num_stars - 1, 1)
                v_rh = v_lf[v_i] / max(v_sz[v_i], 0.5)
                if v_rh >= v_edge[v_i] then
                    if v_i < v_chase then
                        call respawn_chase
                    else
                        call spawn_star
                    endif
                else
                    mplot(int(v_cx + v_ux[v_i] * v_rh), int(v_cy + v_uy[v_i] * v_rh), white, 8 + int(v_rh * v_rh * 0.04))
                endif
            endfor v_i
        else
            v_nseg = 0
            for v_i in (0, v_hyper_stars - 1, 1)
                v_rt = v_lf[v_i] / max(v_sz[v_i] + v_dz, 1)
                if v_rt >= v_edge[v_i] then
                    if v_i < v_chase then
                        call respawn_chase
                    else
                        call spawn_star
                    endif
                else
                    v_rh = v_lf[v_i] / max(v_sz[v_i], 1)
                    v_rh = min(v_rh, v_edge[v_i])
                    if v_rh > v_vlim then
                        v_rt = max(v_rt, v_void_eff)
                        v_mr = (v_rt + v_rh) * 0.5
                        v_b = 8 + int(v_rh * v_rh * 0.04) + v_h15
                        v_u = v_ux[v_i]
                        v_w = v_uy[v_i]
                        v_x0[v_nseg] = v_cx + v_u * v_rt
                        v_y0[v_nseg] = v_cy + v_w * v_rt
                        v_xm[v_nseg] = v_cx + v_u * v_mr
                        v_ym[v_nseg] = v_cy + v_w * v_mr
                        v_x1[v_nseg] = v_cx + v_u * v_rh
                        v_y1[v_nseg] = v_cy + v_w * v_rh
                        v_bi[v_nseg] = int(v_b * 0.5)
                        v_bi2[v_nseg] = v_b
                        mplot(int(v_x1[v_nseg]), int(v_y1[v_nseg]), white, v_b)
                        v_nseg = v_nseg + 1
                    endif
                endif
            endfor v_i
            if v_nseg > 0 then
                draw_lines(v_x0, v_y0, v_xm, v_ym, azure, v_bi, v_nseg)
                draw_lines(v_xm, v_ym, v_x1, v_y1, cyan, v_bi2, v_nseg)
            endif
        endif

        if v_void_eff > 1.5 then
            draw_circle(32, 32, int(v_void_eff), teal, int(v_hyper * 40), false)
        endif
        v_p2 = get_system("runtime")
    end_frame
    v_p3 = get_system("runtime")

    v_s1 = v_s1 + v_p1 - v_now
    v_s2 = v_s2 + v_p2 - v_p1
    v_s3 = v_s3 + v_p3 - v_p2
    v_frames = v_frames + 1
    if v_frames >= 60 then
        v_fps = int(60000 / (v_p3 - v_fps_t0))
        v_fps_t0 = v_p3
        v_a1 = int(v_s1 / 60)
        v_a2 = int(v_s2 / 60)
        v_a3 = int(v_s3 / 60)
        v_s1 = 0
        v_s2 = 0
        v_s3 = 0
        v_frames = 0
    endif
endwhile
