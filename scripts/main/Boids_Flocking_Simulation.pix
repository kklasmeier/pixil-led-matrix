# Boids Flocking Simulation
# Pixil owns events, target steering, trails, and drawing. particle_flock
# performs the expensive everyone-vs-everyone neighborhood steering.

throttle(0)
fps(45)

v_num_boids = 8
v_max_speed = 2.5
v_min_speed = 0.5
v_max_force = 0.3
v_separation_dist = 7
v_neighbor_dist = 15
v_separation_weight = 1.5
v_alignment_weight = 1
v_cohesion_weight = 1
v_boundary_margin = 5
v_wraparound = 1
# Wrap in a world 25% larger on every side of the 64x64 panel so boids leave
# the screen before they reappear. Visible area stays 0..63.
v_wrap_margin = 16
v_world_left = 0 - v_wrap_margin
v_world_right = 64 + v_wrap_margin
v_world_top = 0 - v_wrap_margin
v_world_bottom = 64 + v_wrap_margin
v_wrap_width = v_world_right - v_world_left
v_wrap_height = v_world_bottom - v_world_top
v_tail_length = 3

v_wander_strength = 0.2
v_scatter_chance = 0.005
v_scatter_duration = 60
v_scatter_active = 0
v_scatter_timer = 0
v_target_active = 0
v_target_timer = 0
v_target_x = 32
v_target_y = 32
v_target_duration = 100
v_target_chance = 0.003
v_target_strength = 0.8

create_array(v_pos_x, v_num_boids, numeric)
create_array(v_pos_y, v_num_boids, numeric)
create_array(v_vel_x, v_num_boids, numeric)
create_array(v_vel_y, v_num_boids, numeric)
create_array(v_acc_x, v_num_boids, numeric)
create_array(v_acc_y, v_num_boids, numeric)
create_array(v_active, v_num_boids, numeric)
create_array(v_colors, v_num_boids, numeric)
create_array(v_prev_x, v_num_boids * v_tail_length, numeric)
create_array(v_prev_y, v_num_boids * v_tail_length, numeric)

for v_i in (0, v_num_boids - 1, 1)
    v_pos_x[v_i] = random(5, 59, 0)
    v_pos_y[v_i] = random(5, 59, 0)
    v_angle = random(0, 360, 0)
    v_speed = random(v_min_speed, v_max_speed, 1)
    v_vel_x[v_i] = cos(radians(v_angle)) * v_speed
    v_vel_y[v_i] = sin(radians(v_angle)) * v_speed
    v_acc_x[v_i] = 0
    v_acc_y[v_i] = 0
    v_active[v_i] = 1
    v_colors[v_i] = random(5, 80, 0)
    for v_j in (0, v_tail_length - 1, 1)
        v_idx = v_i * v_tail_length + v_j
        v_prev_x[v_idx] = v_pos_x[v_i]
        v_prev_y[v_idx] = v_pos_y[v_i]
    endfor v_j
endfor v_i

def update_dynamics {
    if v_scatter_active == 0 then
        if random(0, 1, 3) < v_scatter_chance then
            v_scatter_active = 1
            v_scatter_timer = v_scatter_duration
        endif
    else
        v_scatter_timer = v_scatter_timer - 1
        if v_scatter_timer <= 0 then
            v_scatter_active = 0
        endif
    endif

    if v_target_active == 0 then
        if random(0, 1, 3) < v_target_chance then
            v_target_active = 1
            v_target_timer = v_target_duration
            v_target_x = random(10, 54, 0)
            v_target_y = random(10, 54, 0)
        endif
    else
        v_target_timer = v_target_timer - 1
        if v_target_timer <= 0 then
            v_target_active = 0
        endif
    endif
}

def prepare_extra_steering {
    for v_i in (0, v_num_boids - 1, 1)
        v_acc_x[v_i] = random(-1, 1, 2) * v_wander_strength
        v_acc_y[v_i] = random(-1, 1, 2) * v_wander_strength

        # Target chasing remains a show event, separate from flock behavior.
        if v_target_active == 1 then
            v_tar_x = v_target_x - v_pos_x[v_i]
            v_tar_y = v_target_y - v_pos_y[v_i]
            v_tar_mag = sqrt(v_tar_x * v_tar_x + v_tar_y * v_tar_y)
            if v_tar_mag > 0 then
                v_tar_x = (v_tar_x / v_tar_mag) * v_max_speed * v_target_strength - v_vel_x[v_i]
                v_tar_y = (v_tar_y / v_tar_mag) * v_max_speed * v_target_strength - v_vel_y[v_i]
                v_tar_mag = sqrt(v_tar_x * v_tar_x + v_tar_y * v_tar_y)
                if v_tar_mag > v_max_force then
                    v_tar_x = v_tar_x / v_tar_mag * v_max_force
                    v_tar_y = v_tar_y / v_tar_mag * v_max_force
                endif
                v_acc_x[v_i] = v_acc_x[v_i] + v_tar_x
                v_acc_y[v_i] = v_acc_y[v_i] + v_tar_y
            endif
        endif
    endfor v_i
}

def save_trails {
    for v_i in (0, v_num_boids - 1, 1)
        for v_j in (v_tail_length - 1, 1, -1)
            v_idx = v_i * v_tail_length + v_j
            v_prev_idx = v_idx - 1
            v_prev_x[v_idx] = v_prev_x[v_prev_idx]
            v_prev_y[v_idx] = v_prev_y[v_prev_idx]
        endfor v_j
        v_prev_x[v_i * v_tail_length] = v_pos_x[v_i]
        v_prev_y[v_i * v_tail_length] = v_pos_y[v_i]
    endfor v_i
}

def limit_speed {
    for v_i in (0, v_num_boids - 1, 1)
        v_speed = sqrt(v_vel_x[v_i] * v_vel_x[v_i] + v_vel_y[v_i] * v_vel_y[v_i])
        if v_speed > v_max_speed then
            v_vel_x[v_i] = v_vel_x[v_i] / v_speed * v_max_speed
            v_vel_y[v_i] = v_vel_y[v_i] / v_speed * v_max_speed
        elseif v_speed > 0 and v_speed < v_min_speed then
            v_vel_x[v_i] = v_vel_x[v_i] / v_speed * v_min_speed
            v_vel_y[v_i] = v_vel_y[v_i] / v_speed * v_min_speed
        endif
    endfor v_i
}

def wrap_positions {
    for v_i in (0, v_num_boids - 1, 1)
        if v_wraparound == 1 then
            if v_pos_x[v_i] < v_world_left then
                v_pos_x[v_i] = v_pos_x[v_i] + v_wrap_width
            elseif v_pos_x[v_i] >= v_world_right then
                v_pos_x[v_i] = v_pos_x[v_i] - v_wrap_width
            endif
            if v_pos_y[v_i] < v_world_top then
                v_pos_y[v_i] = v_pos_y[v_i] + v_wrap_height
            elseif v_pos_y[v_i] >= v_world_bottom then
                v_pos_y[v_i] = v_pos_y[v_i] - v_wrap_height
            endif
        endif
    endfor v_i
}

def draw_boids {
    begin_frame
        if v_target_active == 1 and v_target_timer % 10 < 5 then
            draw_circle(v_target_x, v_target_y, 2, yellow, 40, false)
        endif

        for v_i in (0, v_num_boids - 1, 1)
            v_color = v_colors[v_i]
            for v_j in (1, v_tail_length - 1, 1)
                v_idx = v_i * v_tail_length + v_j
                v_intensity = 100 - v_j * (80 / v_tail_length)
                v_trail_x = round(v_prev_x[v_idx])
                v_trail_y = round(v_prev_y[v_idx])
                if v_trail_x >= 0 and v_trail_x <= 63 and v_trail_y >= 0 and v_trail_y <= 63 then
                    if v_prev_x[v_idx] != v_prev_x[v_idx - 1] or v_prev_y[v_idx] != v_prev_y[v_idx - 1] then
                        plot(v_trail_x, v_trail_y, v_color, v_intensity)
                    endif
                endif
            endfor v_j

            v_draw_x = round(v_pos_x[v_i])
            v_draw_y = round(v_pos_y[v_i])
            if v_draw_x >= 0 and v_draw_x <= 63 and v_draw_y >= 0 and v_draw_y <= 63 then
                v_heading = atan2(v_vel_y[v_i], v_vel_x[v_i])
                plot(v_draw_x, v_draw_y, v_color, 100)
                v_nose_x = v_draw_x + cos(v_heading) * 2
                v_nose_y = v_draw_y + sin(v_heading) * 2
                draw_line(v_draw_x, v_draw_y, round(v_nose_x), round(v_nose_y), v_color, 100)
            endif
        endfor v_i
    end_frame
}

v_frame = 0
while true then
    call update_dynamics
    call prepare_extra_steering

    if v_scatter_active == 1 then
        particle_flock(v_pos_x, v_pos_y, v_vel_x, v_vel_y, v_acc_x, v_acc_y, v_active, v_separation_dist, v_neighbor_dist, 4.5, 0, 0, v_max_speed, v_max_force, v_wrap_width, v_wrap_height, v_num_boids)
    else
        particle_flock(v_pos_x, v_pos_y, v_vel_x, v_vel_y, v_acc_x, v_acc_y, v_active, v_separation_dist, v_neighbor_dist, v_separation_weight, v_alignment_weight, v_cohesion_weight, v_max_speed, v_max_force, v_wrap_width, v_wrap_height, v_num_boids)
    endif

    # Apply steering without moving, enforce a true magnitude speed limit,
    # then move. This preserves the original update order.
    particle_integrate(v_pos_x, v_pos_y, v_vel_x, v_vel_y, v_active, v_acc_x, v_acc_y, 1, 0, v_num_boids, post_move, 100, 0)
    call limit_speed
    call save_trails
    particle_integrate(v_pos_x, v_pos_y, v_vel_x, v_vel_y, v_active, 0, 0, 1, 0, v_num_boids)
    call wrap_positions
    call draw_boids

    v_frame = v_frame + 1
endwhile
