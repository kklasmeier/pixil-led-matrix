# Atom Viewer
# Picks a random element (H through Ar) and draws it as a classic Bohr model:
# protons (red) and neutrons (blue) packed in the nucleus, electrons (cyan)
# orbiting on circular shells (2, 8, 8 per shell).
# Element name is top-left; atomic notation (mass number over atomic number,
# then symbol) is bottom-left.
# Run: ./run main/Atom_Viewer

# ---------------- Element data (most common isotope) ----------------
create_array(v_names, 18, string)
create_array(v_syms, 18, string)
create_array(v_mass, 18, numeric)

v_names[0] = "Hydrogen"
v_names[1] = "Helium"
v_names[2] = "Lithium"
v_names[3] = "Beryllium"
v_names[4] = "Boron"
v_names[5] = "Carbon"
v_names[6] = "Nitrogen"
v_names[7] = "Oxygen"
v_names[8] = "Fluorine"
v_names[9] = "Neon"
v_names[10] = "Sodium"
v_names[11] = "Magnesium"
v_names[12] = "Aluminum"
v_names[13] = "Silicon"
v_names[14] = "Phosphorus"
v_names[15] = "Sulfur"
v_names[16] = "Chlorine"
v_names[17] = "Argon"

v_syms[0] = "H"
v_syms[1] = "He"
v_syms[2] = "Li"
v_syms[3] = "Be"
v_syms[4] = "B"
v_syms[5] = "C"
v_syms[6] = "N"
v_syms[7] = "O"
v_syms[8] = "F"
v_syms[9] = "Ne"
v_syms[10] = "Na"
v_syms[11] = "Mg"
v_syms[12] = "Al"
v_syms[13] = "Si"
v_syms[14] = "P"
v_syms[15] = "S"
v_syms[16] = "Cl"
v_syms[17] = "Ar"

v_mass[0] = 1
v_mass[1] = 4
v_mass[2] = 7
v_mass[3] = 9
v_mass[4] = 11
v_mass[5] = 12
v_mass[6] = 14
v_mass[7] = 16
v_mass[8] = 19
v_mass[9] = 20
v_mass[10] = 23
v_mass[11] = 24
v_mass[12] = 27
v_mass[13] = 28
v_mass[14] = 31
v_mass[15] = 32
v_mass[16] = 35
v_mass[17] = 40

# ---------------- Layout and working arrays ----------------
v_cx = 38
v_cy = 37
v_r1 = 9
v_r2 = 15
v_r3 = 21
v_hold = 400

create_array(v_nx, 40, numeric)
create_array(v_ny, 40, numeric)
create_array(v_ntype, 40, numeric)
create_array(v_ea, 18, numeric)
create_array(v_er, 18, numeric)
create_array(v_espd, 18, numeric)

v_last = 0
fps(30)

while true then
    # ---------- Pick a new element (never the same twice in a row) ----------
    v_z = random(1, 18, 0)
    while v_z == v_last then
        v_z = random(1, 18, 0)
    endwhile
    v_last = v_z

    v_zi = v_z - 1
    v_a = v_mass[v_zi]
    v_name = v_names[v_zi]
    v_sym = v_syms[v_zi]

    # ---------- Nucleus: sunflower-spiral packing, protons/neutrons mixed ----------
    if v_a <= 16 then
        v_c = 1.4
    else
        v_c = 0.7
    endif
    for v_i in (0, v_a - 1, 1)
        v_nang = v_i * 2.39996
        v_nrad = v_c * sqrt(v_i + 0.5)
        v_nx[v_i] = cos(v_nang) * v_nrad
        v_ny[v_i] = sin(v_nang) * v_nrad
        v_ntype[v_i] = floor((v_i + 1) * v_z / v_a) - floor(v_i * v_z / v_a)
    endfor v_i

    # ---------- Electron shells: 2, 8, 8 ----------
    v_s1 = min(v_z, 2)
    v_s2 = min(max(v_z - 2, 0), 8)
    v_s3 = max(v_z - 10, 0)
    v_lim2 = v_s1 + v_s2
    v_p1 = random(0, 6, 2)
    v_p2 = random(0, 6, 2)
    v_p3 = random(0, 6, 2)

    for v_k in (0, v_z - 1, 1)
        if v_k < v_s1 then
            v_er[v_k] = v_r1
            v_espd[v_k] = 0.11
            v_ea[v_k] = v_k * tau / v_s1 + v_p1
        elseif v_k < v_lim2 then
            v_er[v_k] = v_r2
            v_espd[v_k] = 0.065
            v_ea[v_k] = (v_k - v_s1) * tau / v_s2 + v_p2
        else
            v_er[v_k] = v_r3
            v_espd[v_k] = 0.045
            v_ea[v_k] = (v_k - v_lim2) * tau / v_s3 + v_p3
        endif
    endfor v_k

    # ---------- Show this atom ----------
    for v_f in (0, v_hold, 1)
        begin_frame
            # Name, top-left
            draw_text(1, 1, v_name, tiny64_font, 5, white, 100)

            # Atomic notation, bottom-left: mass number over atomic number, then symbol
            draw_text(1, 50, v_a, tiny64_font, 5, yellow, 100)
            draw_text(1, 57, v_z, tiny64_font, 5, yellow, 100)
            draw_text(10, 53, v_sym, tiny64_font, 5, white, 100)

            # Orbit rings
            if v_s1 > 0 then
                draw_circle(v_cx, v_cy, v_r1, dark_gray, 45, false)
            endif
            if v_s2 > 0 then
                draw_circle(v_cx, v_cy, v_r2, dark_gray, 45, false)
            endif
            if v_s3 > 0 then
                draw_circle(v_cx, v_cy, v_r3, dark_gray, 45, false)
            endif

            # Nucleus
            for v_i in (0, v_a - 1, 1)
                if v_ntype[v_i] == 1 then
                    v_col = "red"
                else
                    v_col = "sky_blue"
                endif
                if v_a <= 16 then
                    draw_circle(round(v_cx + v_nx[v_i]), round(v_cy + v_ny[v_i]), 1, v_col, 100, true)
                else
                    plot(round(v_cx + v_nx[v_i]), round(v_cy + v_ny[v_i]), v_col, 100)
                endif
            endfor v_i

            # Electrons
            for v_k in (0, v_z - 1, 1)
                v_ex = v_cx + cos(v_ea[v_k]) * v_er[v_k]
                v_ey = v_cy + sin(v_ea[v_k]) * v_er[v_k]
                draw_circle(round(v_ex), round(v_ey), 1, cyan, 100, true)
                v_ea[v_k] = v_ea[v_k] + v_espd[v_k]
            endfor v_k
        end_frame
    endfor v_f
endwhile
