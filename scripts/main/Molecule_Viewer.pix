def load_benzene {
    call reset_mol
    v_name = "Benzene"
    v_shape = "Planar 120"
    v_scale = 6.5
    v_rs = 0.75
    v_na = 12
    v_nb = 12
    v_nf = 2
    v_fsym[0] = "C"
    v_fcnt[0] = 6
    v_fw[0] = 4
    v_fsym[1] = "H"
    v_fcnt[1] = 6
    v_fw[1] = 4
    for v_k in (0, 5, 1)
        v_bang = v_k * pi / 3
        v_at[v_k] = 1
        v_ax[v_k] = cos(v_bang) * 1.4
        v_ay[v_k] = sin(v_bang) * 1.4
        v_at[v_k + 6] = 0
        v_ax[v_k + 6] = cos(v_bang) * 2.48
        v_ay[v_k + 6] = sin(v_bang) * 2.48
        v_bf[v_k] = v_k
        v_bt[v_k] = fmod(v_k + 1, 6)
        v_bo[v_k] = 1 + fmod(v_k + 1, 2)
        v_bf[v_k + 6] = v_k
        v_bt[v_k + 6] = v_k + 6
        v_bo[v_k + 6] = 1
    endfor v_k
}

# Formula with subscripts, bottom-left
def draw_formula {
    v_fxc = 1
    for v_s in (0, v_nf - 1, 1)
        draw_text(v_fxc, 56, v_fsym[v_s], tiny64_font, 5, white, 100)
        v_fxc = v_fxc + v_fw[v_s]
        if v_fcnt[v_s] > 1 then
            draw_text(v_fxc, 59, v_fcnt[v_s], tiny64_font, 5, yellow, 100)
            v_fxc = v_fxc + 4
        endif
    endfor v_s
}

fps(30)
clear()

while true then
    # ---------- Pick a new molecule (never the same twice in a row) ----------
    v_pick = random(0, 17, 0)
    while v_pick == v_last then
        v_pick = random(0, 17, 0)
    endwhile
    v_last = v_pick

    if v_pick == 0 then
        call load_water
    elseif v_pick == 1 then
        call load_co2
    elseif v_pick == 2 then
        call load_methane
    elseif v_pick == 3 then
        call load_ammonia
    elseif v_pick == 4 then
        call load_oxygen
    elseif v_pick == 5 then
        call load_nitrogen
    elseif v_pick == 6 then
        call load_acetylene
    elseif v_pick == 7 then
        call load_ethylene
    elseif v_pick == 8 then
        call load_hydrogen
    elseif v_pick == 9 then
        call load_co
    elseif v_pick == 10 then
        call load_ozone
    elseif v_pick == 11 then
        call load_so2
    elseif v_pick == 12 then
        call load_formaldehyde
    elseif v_pick == 13 then
        call load_methanol
    elseif v_pick == 14 then
        call load_ethane
    elseif v_pick == 15 then
        call load_ethanol
    elseif v_pick == 16 then
        call load_acetic
    else
        call load_benzene
    endif

    for v_f in (0, v_hold, 1)
        # ---------- Rotate and project ----------
        v_ang = v_ang + 0.035
        v_tilt = 0.5 + sin(v_f * 0.03) * 0.3
        v_ca = cos(v_ang)
        v_sa = sin(v_ang)
        v_ct = cos(v_tilt)
        v_st = sin(v_tilt)

        for v_i in (0, v_na - 1, 1)
            v_x1 = v_ax[v_i] * v_ca + v_az[v_i] * v_sa
            v_z1 = v_az[v_i] * v_ca - v_ax[v_i] * v_sa
            v_y2 = v_ay[v_i] * v_ct - v_z1 * v_st
            v_z2 = v_ay[v_i] * v_st + v_z1 * v_ct
            v_sx[v_i] = v_cx + v_x1 * v_scale
            v_sy[v_i] = v_cy + v_y2 * v_scale
            v_zk[v_i] = v_z2
            v_ord[v_i] = v_i
        endfor v_i

        # ---------- Sort atoms back to front (bubble sort on depth) ----------
        for v_p in (0, v_na - 2, 1)
            for v_q in (0, v_na - 2 - v_p, 1)
                if v_zk[v_q] > v_zk[v_q + 1] then
                    v_tz = v_zk[v_q]
                    v_zk[v_q] = v_zk[v_q + 1]
                    v_zk[v_q + 1] = v_tz
                    v_to = v_ord[v_q]
                    v_ord[v_q] = v_ord[v_q + 1]
                    v_ord[v_q + 1] = v_to
                endif
            endfor v_q
        endfor v_p

        begin_frame
            draw_text(1, 1, v_name, tiny64_font, 5, white, 100)
            draw_text(1, 8, v_shape, tiny64_font, 5, light_gray, 65)
            call draw_formula

            for v_q in (0, v_na - 1, 1)
                v_ai = v_ord[v_q]
                v_ty = v_at[v_ai]
                v_col = v_ecol[v_ty]
                v_rad = max(1, round(v_erad[v_ty] * v_rs))
                v_dep = v_zk[v_q]
                v_int = min(100, max(45, 78 + v_dep * 12))

                # Half-bonds from this atom toward the midpoint of each bond
                for v_b in (0, v_nb - 1, 1)
                    v_hit = 0
                    if v_bf[v_b] == v_ai then
                        v_oj = v_bt[v_b]
                        v_hit = 1
                    elseif v_bt[v_b] == v_ai then
                        v_oj = v_bf[v_b]
                        v_hit = 1
                    endif
                    if v_hit == 1 then
                        v_mx = (v_sx[v_ai] + v_sx[v_oj]) / 2
                        v_my = (v_sy[v_ai] + v_sy[v_oj]) / 2
                        v_dx = v_mx - v_sx[v_ai]
                        v_dy = v_my - v_sy[v_ai]
                        v_len = sqrt(v_dx * v_dx + v_dy * v_dy)
                        if v_len > 0.5 then
                            v_px = 0 - v_dy / v_len
                            v_py = v_dx / v_len
                            for v_o in (0, v_bo[v_b] - 1, 1)
                                v_off = (v_o - (v_bo[v_b] - 1) / 2) * 2.4
                                draw_line(round(v_sx[v_ai] + v_px * v_off), round(v_sy[v_ai] + v_py * v_off), round(v_mx + v_px * v_off), round(v_my + v_py * v_off), v_col, v_int * 0.8)
                            endfor v_o
                        endif
                    endif
                endfor v_b

                # Atom body with a small highlight for a spherical look
                draw_circle(round(v_sx[v_ai]), round(v_sy[v_ai]), v_rad, v_col, v_int, true)
                if v_rad >= 3 then
                    mplot(round(v_sx[v_ai]) - 1, round(v_sy[v_ai]) - 1, white, 70)
                endif
            endfor v_q
            mflush
        end_frame
    endfor v_f
endwhile
