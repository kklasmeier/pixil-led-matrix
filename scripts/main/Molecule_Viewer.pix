# Molecule Viewer
# Picks a random molecule and shows it as a slowly rotating 3D ball-and-stick
# model with correct geometry. Single, double and triple bonds are drawn as
# 1, 2 or 3 parallel lines. Bonds are split in half and colored by each atom.
# Name is top-left, molecular shape/angle sits under it, and the formula with
# subscripts is bottom-left.
# Atom colors: H white, C gray, N blue, O red, S yellow.
# Run: ./run main/Molecule_Viewer

fps(60)

# ---------------- Element styling (type 0=H 1=C 2=N 3=O 4=S) ----------------
create_array(v_ecol, 5, string)
create_array(v_erad, 5, numeric)
v_ecol[0] = "white"
v_ecol[1] = "gray"
v_ecol[2] = "royal_blue"
v_ecol[3] = "red"
v_erad[0] = 2
v_erad[1] = 4
v_erad[2] = 4
v_erad[3] = 4
v_ecol[4] = "yellow"
v_erad[4] = 5

# ---------------- Working arrays (max 12 atoms, 12 bonds, 3 formula parts) ----------------
create_array(v_at, 12, numeric)
create_array(v_ax, 12, numeric)
create_array(v_ay, 12, numeric)
create_array(v_az, 12, numeric)
create_array(v_sx, 12, numeric)
create_array(v_sy, 12, numeric)
create_array(v_zk, 12, numeric)
create_array(v_ord, 12, numeric)
create_array(v_bf, 12, numeric)
create_array(v_bt, 12, numeric)
create_array(v_bo, 12, numeric)
create_array(v_fsym, 3, string)
create_array(v_fcnt, 3, numeric)
create_array(v_fw, 3, numeric)

v_cx = 34
v_cy = 34
v_hold = 450
v_last = -1
v_ang = 0

# ---------------- Molecule loaders ----------------
def reset_mol {
    v_rs = 1
    for v_i in (0, 11, 1)
        v_at[v_i] = 0
        v_ax[v_i] = 0
        v_ay[v_i] = 0
        v_az[v_i] = 0
    endfor v_i
}

def load_water {
    call reset_mol
    v_name = "Water"
    v_shape = "Bent 104.5"
    v_scale = 14
    v_na = 3
    v_nb = 2
    v_nf = 2
    v_fsym[0] = "H"
    v_fcnt[0] = 2
    v_fw[0] = 4
    v_fsym[1] = "O"
    v_fcnt[1] = 1
    v_fw[1] = 4
    v_at[0] = 3
    v_ay[0] = -0.2
