# Cloth Simulation v2
# Pixil builds and draws a generic net. Reusable particle primitives perform
# Verlet movement and repeated distance-link correction.

v_cols = 6
v_rows = 6
v_point_count = 36
v_link_count = 60
v_spacing = 9
v_start_x = 5
v_start_y = 3

v_gravity = 0.4
v_damping = 0.97
v_rest = 9
v_constraint_iters = 2

create_array(v_px, v_point_count, numeric)
create_array(v_py, v_point_count, numeric)
create_array(v_ox, v_point_count, numeric)
create_array(v_oy, v_point_count, numeric)
create_array(v_active, v_point_count, numeric)
create_array(v_ipx, v_point_count, numeric)
create_array(v_ipy, v_point_count, numeric)

create_array(v_link_from, v_link_count, numeric)
create_array(v_link_to, v_link_count, numeric)
create_array(v_link_tension, v_link_count, numeric)

v_idx = 0
for v_row in (0, v_rows - 1, 1)
    for v_col in (0, v_cols - 1, 1)
        v_px[v_idx] = v_start_x + v_col * v_spacing
        v_py[v_idx] = v_start_y + v_row * v_spacing
        v_ox[v_idx] = v_px[v_idx]
        v_oy[v_idx] = v_py[v_idx]
        v_active[v_idx] = 1
        v_idx = v_idx + 1
    endfor v_col
endfor v_row

# Fixed anchors: inactive points still take part in links but cannot move.
v_active[0] = 0
v_active[2] = 0
v_active[5] = 0

# Build topology once: horizontal links first, then vertical links. This keeps
# the same correction order as the original nested loops.
v_link = 0
for v_row in (0, v_rows - 1, 1)
    for v_col in (0, v_cols - 2, 1)
        v_from = v_row * v_cols + v_col
        v_link_from[v_link] = v_from
        v_link_to[v_link] = v_from + 1
        v_link = v_link + 1
    endfor v_col
endfor v_row
for v_row in (0, v_rows - 2, 1)
    for v_col in (0, v_cols - 1, 1)
        v_from = v_row * v_cols + v_col
        v_link_from[v_link] = v_from
        v_link_to[v_link] = v_from + v_cols
        v_link = v_link + 1
    endfor v_col
endfor v_row

v_frame = 0
throttle(0)
fps(60)

while true then
    particle_verlet_integrate(v_px, v_py, v_ox, v_oy, v_active, 0, v_gravity, v_damping, v_point_count)
    particle_constrain_distances(v_px, v_py, v_active, v_link_from, v_link_to, v_rest, 0.5, v_constraint_iters, v_link_tension, v_point_count, v_link_count, 0.5)

    # Keep free cloth points on the panel. Anchors stay exactly where placed.
    for v_i in (0, v_point_count - 1, 1)
        if v_active[v_i] == 1 then
            v_py[v_i] = min(62, max(1, v_py[v_i]))
            v_px[v_i] = min(62, max(1, v_px[v_i]))
        endif
    endfor v_i

    # Occasional gusts remain show behavior, so they stay in Pixil.
    v_wc = v_frame % 150
    if v_wc == 75 then
        for v_i in (0, v_point_count - 1, 1)
            if v_active[v_i] == 1 then
                v_px[v_i] = v_px[v_i] + 2.5
            endif
        endfor v_i
    elseif v_wc == 100 then
        for v_i in (0, v_point_count - 1, 1)
            if v_active[v_i] == 1 then
                v_px[v_i] = v_px[v_i] - 2
            endif
        endfor v_i
    endif

    for v_i in (0, v_point_count - 1, 1)
        v_ipx[v_i] = int(v_px[v_i])
        v_ipy[v_i] = int(v_py[v_i])
    endfor v_i

    begin_frame
        for v_link in (0, v_link_count - 1, 1)
            v_from = v_link_from[v_link]
            v_to = v_link_to[v_link]
            draw_line(v_ipx[v_from], v_ipy[v_from], v_ipx[v_to], v_ipy[v_to], cyan, 60)
        endfor v_link
        plot(v_ipx[0], v_ipy[0], red, 100)
        plot(v_ipx[2], v_ipy[2], red, 100)
        plot(v_ipx[5], v_ipy[5], red, 100)
    end_frame

    v_frame = v_frame + 1
endwhile
