# Radioactive Decay
# A 10x10 block of 100 unstable nuclei (green). Each frame every remaining
# atom has the same small chance of decaying, which is exactly what a half-life
# means. A decaying atom flashes, fires off a radiation particle, and becomes
# the daughter element (blue). A bar graph on the right records how many
# atoms remain over time, with the ideal half-life curve as white dots.
#
# Top-left: isotope name, real half-life and decay type, then the daughter.
# Particle colors: alpha orange (big), beta yellow, gamma white.
# The simulation speed is random per isotope; the real half-life is just a label.
# Run: ./run main/Radioactive_Decay

# ---------------- State arrays ----------------
create_array(v_st, 100, numeric)
create_array(v_tm, 100, numeric)
create_array(v_hist, 16, numeric)
create_array(v_ppx, 12, numeric)
create_array(v_ppy, 12, numeric)
create_array(v_pvx, 12, numeric)
create_array(v_pvy, 12, numeric)
create_array(v_plife, 12, numeric)

v_last = -1

# ---------------- Isotope table (mode 0=alpha 1=beta 2=gamma) ----------------
def load_iso {
    if v_iso == 0 then
        v_name = "Carbon-14"
        v_info = "5730 yr Beta"
        v_dname = "-> Nitrogen-14"
        v_mode = 1
    elseif v_iso == 1 then
        v_name = "Uranium-238"
        v_info = "4.5B yr Alpha"
        v_dname = "-> Thorium-234"
        v_mode = 0
    elseif v_iso == 2 then
        v_name = "Radon-222"
        v_info = "3.8 day Alpha"
        v_dname = "-> Polonium-218"
        v_mode = 0
    elseif v_iso == 3 then
        v_name = "Iodine-131"
        v_info = "8 day Beta"
        v_dname = "-> Xenon-131"
        v_mode = 1
    elseif v_iso == 4 then
        v_name = "Cobalt-60"
        v_info = "5.3 yr Beta"
        v_dname = "-> Nickel-60"
        v_mode = 1
    elseif v_iso == 5 then
        v_name = "Tritium"
        v_info = "12.3 yr Beta"
        v_dname = "-> Helium-3"
        v_mode = 1
    elseif v_iso == 6 then
        v_name = "Technetium-99m"
        v_info = "6 hr Gamma"
        v_dname = "-> Tc-99"
        v_mode = 2
    elseif v_iso == 7 then
        v_name = "Polonium-210"
        v_info = "138 day Alpha"
        v_dname = "-> Lead-206"
        v_mode = 0
    elseif v_iso == 8 then
        v_name = "Strontium-90"
        v_info = "29 yr Beta"
        v_dname = "-> Yttrium-90"
        v_mode = 1
    elseif v_iso == 9 then
        v_name = "Radium-226"
        v_info = "1600 yr Alpha"
        v_dname = "-> Radon-222"
        v_mode = 0
    else
        v_name = "Potassium-40"
        v_info = "1.25B yr Beta"
        v_dname = "-> Calcium-40"
        v_mode = 1
    endif

    if v_mode == 0 then
        v_pcol = "orange"
    elseif v_mode == 1 then
        v_pcol = "yellow"
    else
        v_pcol = "white"
    endif
}

fps(30)
clear()

while true then
    # ---------- Pick an isotope (never the same twice in a row) ----------
    v_iso = random(0, 10, 0)
    while v_iso == v_last then
        v_iso = random(0, 10, 0)
    endwhile
    v_last = v_iso
    call load_iso

    # ---------- Reset the experiment ----------
    for v_i in (0, 99, 1)
        v_st[v_i] = 0
        v_tm[v_i] = 0
    endfor v_i
    for v_i in (0, 15, 1)
        v_hist[v_i] = 0
    endfor v_i
    for v_i in (0, 11, 1)
        v_plife[v_i] = 0
    endfor v_i

    v_alive = 100
    v_decayed = 0
    v_slot = 0

    # Visual half-life in frames (about 3 to 5 seconds), and per-frame decay chance
    v_hlf = random(90, 150, 0)
    v_pdec = 1 - pow(0.5, 1 / v_hlf)
    v_binw = v_hlf / 4
    v_dend = round(v_hlf * 4.5)
    v_total = v_dend + 120

    for v_f in (0, v_total, 1)
        v_dec_now = 0

        # ---------- Decay physics ----------
        for v_i in (0, 99, 1)
            if v_st[v_i] == 0 then
                if v_f < v_dend then
                    if random(0, 1, 4) < v_pdec then
                        v_st[v_i] = 1
                        v_tm[v_i] = 8
                        v_alive = v_alive - 1
                        v_decayed = v_decayed + 1
                        v_dec_now = v_dec_now + 1
                        v_ang = random(0, 6.28, 2)
                        v_ppx[v_slot] = 3 + fmod(v_i, 10) * 4
                        v_ppy[v_slot] = 24 + floor(v_i / 10) * 4
                        v_pvx[v_slot] = cos(v_ang) * 1.4
                        v_pvy[v_slot] = sin(v_ang) * 1.4
                        v_plife[v_slot] = 16
                        v_slot = fmod(v_slot + 1, 12)
                    endif
                endif
            elseif v_st[v_i] == 1 then
                v_tm[v_i] = v_tm[v_i] - 1
                if v_tm[v_i] <= 0 then
                    v_st[v_i] = 2
                endif
            endif
        endfor v_i

        for v_k in (0, 11, 1)
            if v_plife[v_k] > 0 then
                v_ppx[v_k] = v_ppx[v_k] + v_pvx[v_k]
                v_ppy[v_k] = v_ppy[v_k] + v_pvy[v_k]
                v_plife[v_k] = v_plife[v_k] - 1
                if v_ppx[v_k] < 0 or v_ppx[v_k] > 43 or v_ppy[v_k] < 20 or v_ppy[v_k] > 62 then
                    v_plife[v_k] = 0
                endif
            endif
        endfor v_k

        # Record the surviving count for the graph (16 bins over 4 half-lives)
        v_bin = floor(v_f / v_binw)
        if v_bin <= 15 then
            v_hist[v_bin] = v_alive
        endif
        v_curbin = min(v_bin, 15)

        # ---------- Draw ----------
        begin_frame
            draw_text(1, 1, v_name, tiny64_font, 5, white, 100)
            draw_text(1, 8, v_info, tiny64_font, 5, light_gray, 65)
            draw_text(1, 15, v_dname, tiny64_font, 5, sky_blue, 80)

            # Atom block
            for v_i in (0, 99, 1)
                v_gx = 3 + fmod(v_i, 10) * 4
                v_gy = 24 + floor(v_i / 10) * 4
                if v_st[v_i] == 0 then
                    draw_circle(v_gx, v_gy, 1, lime, 90, true)
                elseif v_st[v_i] == 1 then
                    v_rr = round(1 + (8 - v_tm[v_i]) * 0.5)
                    draw_circle(v_gx, v_gy, 1, white, 100, true)
                    draw_circle(v_gx, v_gy, v_rr, v_pcol, v_tm[v_i] * 12, false)
                else
                    draw_circle(v_gx, v_gy, 1, sky_blue, 60, true)
                endif
            endfor v_i

            # Radiation particles
            for v_k in (0, 11, 1)
                if v_plife[v_k] > 0 then
                    v_pint = min(100, v_plife[v_k] * 7)
                    if v_mode == 0 then
                        draw_circle(round(v_ppx[v_k]), round(v_ppy[v_k]), 1, v_pcol, v_pint, true)
                    else
                        plot(round(v_ppx[v_k]), round(v_ppy[v_k]), v_pcol, v_pint)
                    endif
                endif
            endfor v_k

            # Graph: axes, half-life ticks, measured bars, ideal curve
            draw_line(46, 24, 46, 44, gray, 60)
            draw_line(46, 44, 62, 44, gray, 60)
            plot(51, 45, gray, 60)
            plot(55, 45, gray, 60)
            plot(59, 45, gray, 60)
            plot(45, 34, gray, 50)
            for v_i in (0, v_curbin, 1)
                v_h = round(v_hist[v_i] * 0.19)
                if v_h > 0 then
                    draw_line(47 + v_i, 43, 47 + v_i, 44 - v_h, lime, 80)
                endif
            endfor v_i
            for v_i in (0, 15, 1)
                plot(47 + v_i, round(44 - 19 * pow(0.5, v_i / 4)), white, 40)
            endfor v_i

            # Counters: remaining parents and daughters
            draw_text(46, 48, v_alive, tiny64_font, 5, lime, 100)
            draw_text(46, 56, v_decayed, tiny64_font, 5, sky_blue, 100)

            # Geiger-counter blip in the corner on each decay
            if v_dec_now > 0 then
                draw_rectangle(61, 1, 2, 2, white, 100, true)
            endif
        end_frame
    endfor v_f
endwhile
