# ==============================================================================
# WIREFRAME POLYHEDRA  (64x64 matrix)
#
# Rotating wire solids with a slow gallery of shapes. Spin rate breathes.
# Shape changes morph via array_lerp (verts) + edge crossfade.
# Each shape has its own spectral wire color; colors crossfade with the morph.
# Soft same-hue glow + white tips.
# Uses points_project3d + array_lerp + draw_lines.
# ==============================================================================

clear()
fps(60)
throttle(0)

v_max_v = 12
v_max_e = 30

v_cx = 32
v_cy = 32
v_scale = 22
v_camera = 48

v_rx = 0.4
v_ry = 0.0
v_rz = 0.15
v_t = 0.0

v_shape = 0
v_nshapes = 8
v_phase = 0
v_hold = 0
v_hold_max = 160
v_morph = 0
v_morph_max = 56
v_blend = 0.0
v_fade_a = 1.0
v_fade_b = 0.0
v_nverts = 4
v_nedges = 6
v_nv_a = 4
v_ne_a = 6
v_nv_b = 4
v_ne_b = 6
v_nv_last = 3
v_ne_last = 5
v_glow = 18
v_wire = 55
v_c_a = 55
v_c_b = 55

v_i = 0
v_a = 0
v_b = 0
v_d = 0.0
v_bright = 0
v_s = 0.0
v_vx = 0.0
v_vy = 0.0
v_vz = 0.0
v_x = 0.5257311121
v_z = 0.8506508084
v_cxa = 0.0
v_cya = 0.0
v_cza = 0.0
v_cxb = 0.0
v_cyb = 0.0
v_czb = 0.0

v_spmod = 1.0
v_spx = 0.016
v_spy = 0.022
v_spz = 0.01

create_array(v_wx, v_max_v, numeric)
create_array(v_wy, v_max_v, numeric)
create_array(v_wz, v_max_v, numeric)
create_array(v_ax, v_max_v, numeric)
create_array(v_ay, v_max_v, numeric)
create_array(v_az, v_max_v, numeric)
create_array(v_bx, v_max_v, numeric)
create_array(v_by, v_max_v, numeric)
create_array(v_bz, v_max_v, numeric)
create_array(v_sx, v_max_v, numeric)
create_array(v_sy, v_max_v, numeric)
create_array(v_depth, v_max_v, numeric)
create_array(v_ea, v_max_e, numeric)
create_array(v_eb, v_max_e, numeric)
create_array(v_ea_a, v_max_e, numeric)
create_array(v_eb_a, v_max_e, numeric)
create_array(v_ea_b, v_max_e, numeric)
create_array(v_eb_b, v_max_e, numeric)
create_array(v_x0, v_max_e, numeric)
create_array(v_y0, v_max_e, numeric)
create_array(v_x1, v_max_e, numeric)
create_array(v_y1, v_max_e, numeric)
create_array(v_inten, v_max_e, numeric)

# Per-shape spectral wire colors (0-99)
create_array(v_palette, v_nshapes, numeric)
v_palette[0] = 55
v_palette[1] = 14
v_palette[2] = 70
v_palette[3] = 34
v_palette[4] = 86
v_palette[5] = 6
v_palette[6] = 46
v_palette[7] = 22
v_wire = v_palette[0]
v_c_a = v_wire
v_c_b = v_wire

def set_vert {
    v_wx[v_i] = v_vx
    v_wy[v_i] = v_vy
    v_wz[v_i] = v_vz
    v_i = v_i + 1
}

def set_edge {
    v_ea[v_i] = v_a
    v_eb[v_i] = v_b
    v_i = v_i + 1
}

def load_tetra {
    v_nverts = 4
    v_nedges = 6
    v_i = 0
    v_s = 1.15
    v_vx = v_s
    v_vy = v_s
    v_vz = v_s
    call set_vert
    v_vx = v_s
    v_vy = 0 - v_s
    v_vz = 0 - v_s
    call set_vert
    v_vx = 0 - v_s
    v_vy = v_s
    v_vz = 0 - v_s
    call set_vert
    v_vx = 0 - v_s
    v_vy = 0 - v_s
    v_vz = v_s
    call set_vert
    v_i = 0
    v_a = 0
    v_b = 1
    call set_edge
    v_a = 0
    v_b = 2
    call set_edge
    v_a = 0
    v_b = 3
    call set_edge
    v_a = 1
    v_b = 2
    call set_edge
    v_a = 1
    v_b = 3
    call set_edge
    v_a = 2
    v_b = 3
    call set_edge
}

