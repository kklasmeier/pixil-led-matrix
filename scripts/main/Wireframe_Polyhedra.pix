def load_shape {
    if v_shape == 0 then
        call load_tetra
    endif
    if v_shape == 1 then
        call load_pyramid
    endif
    if v_shape == 2 then
        call load_cube
    endif
    if v_shape == 3 then
        call load_prism
    endif
    if v_shape == 4 then
        call load_octa
    endif
    if v_shape == 5 then
        call load_bipyramid
    endif
    if v_shape == 6 then
        call load_cubocta
    endif
    if v_shape == 7 then
        call load_icosa
    endif
    v_nv_last = v_nverts - 1
    v_ne_last = v_nedges - 1
}

def copy_world_to_a {
    v_nv_a = v_nverts
    v_ne_a = v_nedges
    v_nv_last = v_nverts - 1
    v_ne_last = v_nedges - 1
    for v_i in (0, v_nv_last, 1)
        v_ax[v_i] = v_wx[v_i]
        v_ay[v_i] = v_wy[v_i]
        v_az[v_i] = v_wz[v_i]
    endfor v_i
    for v_i in (0, v_ne_last, 1)
        v_ea_a[v_i] = v_ea[v_i]
        v_eb_a[v_i] = v_eb[v_i]
    endfor v_i
}

def copy_world_to_b {
    v_nv_b = v_nverts
    v_ne_b = v_nedges
    v_nv_last = v_nverts - 1
    v_ne_last = v_nedges - 1
    for v_i in (0, v_nv_last, 1)
        v_bx[v_i] = v_wx[v_i]
        v_by[v_i] = v_wy[v_i]
        v_bz[v_i] = v_wz[v_i]
    endfor v_i
    for v_i in (0, v_ne_last, 1)
        v_ea_b[v_i] = v_ea[v_i]
        v_eb_b[v_i] = v_eb[v_i]
    endfor v_i
}

def pad_morph_verts {
    # Extra verts grow from / collapse into each shape's centroid
    v_nverts = v_nv_a
    if v_nv_b > v_nverts then
        v_nverts = v_nv_b
    endif
    v_cxa = 0
    v_cya = 0
    v_cza = 0
    v_nv_last = v_nv_a - 1
    for v_i in (0, v_nv_last, 1)
        v_cxa = v_cxa + v_ax[v_i]
        v_cya = v_cya + v_ay[v_i]
        v_cza = v_cza + v_az[v_i]
    endfor v_i
    v_cxa = v_cxa / v_nv_a
    v_cya = v_cya / v_nv_a
    v_cza = v_cza / v_nv_a
    v_cxb = 0
    v_cyb = 0
    v_czb = 0
    v_nv_last = v_nv_b - 1
    for v_i in (0, v_nv_last, 1)
        v_cxb = v_cxb + v_bx[v_i]
        v_cyb = v_cyb + v_by[v_i]
        v_czb = v_czb + v_bz[v_i]
    endfor v_i
    v_cxb = v_cxb / v_nv_b
    v_cyb = v_cyb / v_nv_b
    v_czb = v_czb / v_nv_b
    if v_nv_a < v_nverts then
        for v_i in (v_nv_a, v_nverts - 1, 1)
            v_ax[v_i] = v_cxa
            v_ay[v_i] = v_cya
            v_az[v_i] = v_cza
        endfor v_i
    endif
    if v_nv_b < v_nverts then
        for v_i in (v_nv_b, v_nverts - 1, 1)
            v_bx[v_i] = v_cxb
            v_by[v_i] = v_cyb
            v_bz[v_i] = v_czb
        endfor v_i
    endif
    v_nv_last = v_nverts - 1
}

def begin_morph {
    call copy_world_to_a
    v_c_a = v_palette[v_shape]
    v_shape = v_shape + 1
    if v_shape >= v_nshapes then
        v_shape = 0
    endif
    v_c_b = v_palette[v_shape]
    call load_shape
    call copy_world_to_b
    call pad_morph_verts
    v_phase = 1
    v_morph = 0
    v_blend = 0
    v_fade_a = 1
    v_fade_b = 0
    # Hold the outgoing shape until the morph loop advances blend
    for v_i in (0, v_nv_last, 1)
        v_wx[v_i] = v_ax[v_i]
        v_wy[v_i] = v_ay[v_i]
        v_wz[v_i] = v_az[v_i]
    endfor v_i
}

def finish_morph {
    v_nverts = v_nv_b
    v_nedges = v_ne_b
    v_nv_last = v_nverts - 1
    v_ne_last = v_nedges - 1
    for v_i in (0, v_nv_last, 1)
        v_wx[v_i] = v_bx[v_i]
        v_wy[v_i] = v_by[v_i]
        v_wz[v_i] = v_bz[v_i]
    endfor v_i
    for v_i in (0, v_ne_last, 1)
        v_ea[v_i] = v_ea_b[v_i]
        v_eb[v_i] = v_eb_b[v_i]
    endfor v_i
    v_wire = v_c_b
    v_phase = 0
    v_hold = 0
    v_morph = 0
    v_blend = 0
    v_fade_a = 1
    v_fade_b = 0
}

def pack_edges_a {
    v_ne_last = v_ne_a - 1
    for v_i in (0, v_ne_last, 1)
        v_a = int(v_ea_a[v_i])
        v_b = int(v_eb_a[v_i])
        v_x0[v_i] = v_sx[v_a]
        v_y0[v_i] = v_sy[v_a]
        v_x1[v_i] = v_sx[v_b]
        v_y1[v_i] = v_sy[v_b]
        v_d = (v_depth[v_a] + v_depth[v_b]) * 0.5
        v_bright = 28 + int((1.2 - v_d) * 38)
        if v_bright < 12 then
            v_bright = 12
        endif
        if v_bright > 95 then
            v_bright = 95
        endif
        v_inten[v_i] = int(v_bright * v_fade_a)
    endfor v_i
}

def pack_edges_b {
    v_ne_last = v_ne_b - 1
    for v_i in (0, v_ne_last, 1)
        v_a = int(v_ea_b[v_i])
        v_b = int(v_eb_b[v_i])
        v_x0[v_i] = v_sx[v_a]
        v_y0[v_i] = v_sy[v_a]
        v_x1[v_i] = v_sx[v_b]
        v_y1[v_i] = v_sy[v_b]
        v_d = (v_depth[v_a] + v_depth[v_b]) * 0.5
        v_bright = 28 + int((1.2 - v_d) * 38)
        if v_bright < 12 then
            v_bright = 12
        endif
        if v_bright > 95 then
            v_bright = 95
        endif
        v_inten[v_i] = int(v_bright * v_fade_b)
    endfor v_i
}

def pack_edges_hold {
    v_ne_last = v_nedges - 1
    for v_i in (0, v_ne_last, 1)
        v_a = int(v_ea[v_i])
        v_b = int(v_eb[v_i])
        v_x0[v_i] = v_sx[v_a]
        v_y0[v_i] = v_sy[v_a]
        v_x1[v_i] = v_sx[v_b]
        v_y1[v_i] = v_sy[v_b]
        v_d = (v_depth[v_a] + v_depth[v_b]) * 0.5
        v_bright = 28 + int((1.2 - v_d) * 38)
        if v_bright < 12 then
            v_bright = 12
        endif
        if v_bright > 95 then
            v_bright = 95
        endif
        v_inten[v_i] = v_bright
    endfor v_i
}

print("Wireframe Polyhedra")
call load_shape

while true then
    v_t = v_t + 0.012
    if v_t > tau * 64 then
        v_t = v_t - tau * 64
    endif

    # Speed breathes — floor a bit higher, peaks a bit quicker
    v_spmod = 0.86 + 0.42 * (0.5 + 0.5 * sin(v_t * 0.31))
    v_spx = (0.013 + 0.007 * sin(v_t * 0.19)) * v_spmod
    v_spy = (0.020 + 0.010 * cos(v_t * 0.23)) * v_spmod
    v_spz = (0.009 + 0.006 * sin(v_t * 0.17 + 1.1)) * v_spmod

    v_rx = v_rx + v_spx
    v_ry = v_ry + v_spy
    v_rz = v_rz + v_spz
    if v_rx > tau then
        v_rx = v_rx - tau
    endif
    if v_ry > tau then
        v_ry = v_ry - tau
    endif
    if v_rz > tau then
        v_rz = v_rz - tau
    endif

    if v_phase == 0 then
        v_hold = v_hold + 1
        if v_hold >= v_hold_max then
            call begin_morph
        endif
    else
        v_morph = v_morph + 1
        v_s = v_morph / v_morph_max
        if v_s > 1 then
            v_s = 1
        endif
        v_blend = v_s * v_s * (3 - 2 * v_s)
        v_fade_a = 1 - v_blend
        v_fade_b = v_blend
        array_lerp(v_ax, v_bx, v_wx, v_blend, v_nverts)
        array_lerp(v_ay, v_by, v_wy, v_blend, v_nverts)
        array_lerp(v_az, v_bz, v_wz, v_blend, v_nverts)
        if v_morph >= v_morph_max then
            call finish_morph
        endif
    endif

    v_scale = 20.5 + 2.8 * sin(v_t * 0.27)

    points_project3d(v_wx, v_wy, v_wz, v_sx, v_sy, v_rx, v_ry, v_rz, v_scale, v_camera, v_cx, v_cy, v_depth, v_nverts)

    begin_frame
        if v_phase == 0 then
            v_wire = v_palette[v_shape]
            call pack_edges_hold
            draw_lines(v_x0, v_y0, v_x1, v_y1, v_wire, 18, v_nedges)
            draw_lines(v_x0, v_y0, v_x1, v_y1, v_wire, v_inten, v_nedges)
        else
            if v_fade_a > 0.02 then
                call pack_edges_a
                v_glow = int(18 * v_fade_a)
                if v_glow < 1 then
                    v_glow = 1
                endif
                draw_lines(v_x0, v_y0, v_x1, v_y1, v_c_a, v_glow, v_ne_a)
                draw_lines(v_x0, v_y0, v_x1, v_y1, v_c_a, v_inten, v_ne_a)
            endif
            if v_fade_b > 0.02 then
                call pack_edges_b
                v_glow = int(18 * v_fade_b)
                if v_glow < 1 then
                    v_glow = 1
                endif
                draw_lines(v_x0, v_y0, v_x1, v_y1, v_c_b, v_glow, v_ne_b)
                draw_lines(v_x0, v_y0, v_x1, v_y1, v_c_b, v_inten, v_ne_b)
            endif
        endif
        for v_i in (0, v_nv_last, 1)
            v_bright = 40 + int((1.0 - v_depth[v_i]) * 45)
            if v_bright < 20 then
                v_bright = 20
            endif
            if v_bright > 100 then
                v_bright = 100
            endif
            mplot(int(v_sx[v_i]), int(v_sy[v_i]), white, v_bright)
        endfor v_i
    end_frame
endwhile
